# Project Stack
#
# Generated by bootstrap.py — edit values below to match your project.
# This file is read by all SDD_Pro agents at every invocation.
# `workspace/stack/stack.md` is gitignored (contains local secrets
# in clear) ; this `.template` file is the versioned skeleton.
#
# ═══════════════════════════════════════════════════════════════════════════
# 🔒 SECRETS & CONFIG — stack.md IS THE SINGLE SOURCE OF TRUTH (v7.0.0)
# ═══════════════════════════════════════════════════════════════════════════
# This file contains REAL values in clear (DB_PASSWORD, AUTH_JWT_SECRET,
# AZ_TENANTID, SMTP_*…). It is gitignored — never committed.
#
# Propagation contract (Pattern B, 2026-05-14 onward) :
#   1. The Tech Lead writes values directly in sections `## Active Auth Specs`,
#      `## Active Database`, `## Active SMTP Server` below.
#   2. Agent `arch` Phase A reads stack.md and populates the native config of
#      the target stack :
#        - .NET     → `appsettings.json` `ConnectionStrings:Default` + `AzureAd:*`
#        - Spring   → `application.yml` `spring.datasource.*` + `auth.jwt.*`
#        - Node     → `config/default.json` `db.*` + `auth.*`
#        - Python   → `app/config.py` `db_settings` + `auth_settings`
#   3. The generated app code reads ONLY the native config (`IConfiguration`,
#      `@Value`, `config.get('db')`, `Settings()`). It NEVER reads env vars
#      for these keys — that is reported as `[SEC_ENV_VAR_FORBIDDEN]`.
#
# .gitignore MUST exclude :
#   workspace/stack/stack.md
#   appsettings.Development.json (or any generated appsettings*.json with secrets)
#   config/local.json / application-local.yml
#   plus every generated project must copy :
#   .claude/templates/generated-project.gitignore.template → {ProjectName}/.gitignore
# ═══════════════════════════════════════════════════════════════════════════

## Active Harness
# Where the LLM orchestration runs. Defaults to claude-code (rétro-compat).
# Options : claude-code | codex | antigravity | gemini-cli
# SSoT machine : .sdd/capability-matrix.yml (harness × mechanism support level)
Harness: claude-code

## Active Model Provider
# Which vendor executes the tokens. Independent from Harness.
# Options : anthropic | openai | google | moonshot
# Endpoint : "default" = provider standard URL. Set a custom URL for proxies
#            (e.g. Kimi via ANTHROPIC_BASE_URL / OpenAI-compat endpoint).
# ModelTierMap : optional per-tier override. Cross-provider mixing is allowed
#                (e.g. deep=anthropic for critical work, balanced/fast=moonshot
#                as cost lever). Absent map = all tiers use Provider above.
Provider: anthropic
Endpoint: default
ModelTierMap:
  deep: anthropic
  balanced: anthropic
  fast: anthropic

## Model Selection
# Mode : static (default) | dynamic
#   static  : each agent gets its fixed tier_default (.sdd/agent-bounds.yaml).
#             Preserves current behavior. Absence of this section = static.
#   dynamic : (opt-in, 🟡 UNTESTED until conformance run §10 of migration plan)
#             At each spawn the deterministic scorer (0 token) computes the
#             work-item complexity → candidate tier, CLAMPED by tier_floor /
#             tier_ceiling declared per agent. Bounds are quality invariants,
#             NOT overridable by Project Config. Decisions persisted in
#             workspace/.sys/.routing/{n}[-{m}]-model-routing.json for audit.
Mode: static

## Project Config
# FrontendName/BackendName = project names ; AppNamespace/BackendNamespace
# auto-derived (= project name, cf. CLAUDE.md §1 + ownership.md §1.bis).
# For fullstack stacks : drop the "Front" suffix (e.g. {{AppName}}Front → {{AppName}}).
AppName: {{AppName}}
FrontendName: {{AppName}}
FrontendLocalPort: {{FrontendPort}}
BackendName: {{BackendName}}
BackendLocalPort: {{BackendPort}}
LibStrategy: {{LibStrategy}}
PlanReviewDefault: true

# QA mode :
#   off | quality-only | tests-only | tests+coverage | full | manual
QAMode: tests+coverage
CoverageMin: 80
MaxParallel: 3

# Acceptance Gate — recette executable post-QA (test / lint / build /
# coverage / smoke / E2E) sur le code materialise. off | warn | strict.
# `strict` = un check KO arrete le pipeline ([ACCEPTANCE_GATE_FAILED]).
AcceptanceGate: strict
# AcceptanceGate.RequireE2E: true      # exiger >= 1 test E2E vert
# AcceptanceGate.SmokeTimeout: 10      # secondes avant abandon du smoke
# AcceptanceGate.MinCoverage: 80       # plancher coverage propre a la gate

# Cost caps (USD, see config.base.yml for full doc) :
MaxCostPerRun: 50
BuildLoopMaxCostUsd: 15
BuildLoopMaxIter: 3

# FailOn severity thresholds : info | minor | moderate | serious | critical
CodeReviewFailOn: critical
SecurityFailOn: critical
SpecComplianceFailOn: serious
ArchReviewFailOn: serious

# US granularity (1-6 per FEAT recommended) :
UsGranularityTarget: 3

# OWASP scan : keep true for serious runs
SecurityScanEnabled: true

# Auditor modes : off | manual | full
CodeReviewMode: full
SecurityMode: full
SpecComplianceMode: full
ArchReviewMode: manual
A11yMode: "off"
PerfMode: "off"

