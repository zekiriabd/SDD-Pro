{
  "$schema": "../../templates/libs-catalog.schema.json",
  "stackId": "nestjs",
  "category": "backend",
  "schemaVersion": 1,
  "buildSystem": "pnpm",
  "manifest": {
    "files": [
      "workspace/src/{BackendName}/package.json",
      "workspace/src/{BackendName}/tsconfig.json",
      "workspace/src/{BackendName}/nest-cli.json",
      "workspace/src/{BackendName}/src/main.ts",
      "workspace/src/{BackendName}/src/app.module.ts",
      "workspace/src/{BackendName}/.env.example"
    ]
  },
  "metadata": {
    "lastUpdated": "2026-09-02",
    "runtime": "node 22 LTS",
    "framework": "nestjs 12",
    "notes": "Stack backend API NestJS 12 (TypeScript, decorateurs, DI par modules). Consomme une base declaree par DatabaseType ; expose une API REST a un frontend separe. buildSystem=pnpm, aligne sur backend/node-express. DEUX PIEGES DE REGISTRE, verifies le 2026-09-02 : (1) TYPESCRIPT EST PLAFONNE SOUS LA 7 — `@nestjs/cli` 12 depend de `typescript: ~6.0.2` et `ts-jest` 29.4.12 declare le peer `typescript: >=4.3 <7`. La 7.0.2 est disponible sur npm et casse la chaine de build. Pin 6.0.3. (2) PRISMA : le dist-tag npm `latest` du paquet `prisma` pointe sur 8.0.0-rc.12, une PRERELEASE ; la derniere stable est la 7.10.0 (dist-tag `prev`), et c'est la version alignee avec @prisma/client 7.10.0. Ne jamais installer `prisma@latest` sur ce stack. ORM par defaut = TypeORM 1.1.1 via @nestjs/typeorm (integration officielle) ; Prisma est propose en capability alternative exclusive."
  },
  "versions": {
    "nest": "12.0.1",
    "nest-config": "12.0.0",
    "nest-cli": "12.0.0",
    "nest-schematics": "12.0.0",
    "nest-passport": "12.0.0",
    "nest-terminus": "12.0.0",
    "nest-cache": "12.0.0",
    "nest-throttler": "6.5.0",
    "nest-bullmq": "12.0.0",
    "nest-event-emitter": "12.0.0",
    "nest-microservices": "12.0.1",
    "typescript": "6.0.3",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "class-validator": "0.15.1",
    "class-transformer": "0.5.1",
    "typeorm": "1.1.1",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "helmet": "8.3.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "argon2": "0.45.1",
    "pino": "10.3.1",
    "nestjs-pino": "5.1.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "zod": "4.5.4",
    "nestjs-zod": "5.5.0",
    "cache-manager": "7.2.9",
    "bullmq": "6.3.4",
    "ioredis": "6.0.0",
    "sentry-nestjs": "10.73.0",
    "jest": "30.5.1",
    "ts-jest": "29.4.12",
    "supertest": "7.2.2",
    "supertest-types": "7.2.1",
    "node-types": "26.4.1",
    "express-types": "5.0.6",
    "jest-types": "30.0.0",
    "eslint": "10.9.1",
    "typescript-eslint": "8.69.0",
    "prettier": "3.9.6"
  },
  "core": [
    { "module": "@nestjs/core", "ref": "nest", "rationale": "Noyau — conteneur DI, cycle de vie des modules" },
    { "module": "@nestjs/common", "ref": "nest", "rationale": "Decorateurs, pipes, guards, interceptors" },
    { "module": "@nestjs/platform-express", "ref": "nest", "rationale": "Adaptateur HTTP Express (defaut). L'adaptateur Fastify est en capability `fastify-adapter`" },
    { "module": "@nestjs/config", "ref": "nest-config", "rationale": "Configuration typee + validation au demarrage — evite process.env disperse" },
    { "module": "@nestjs/swagger", "ref": "nest", "rationale": "OpenAPI 3 genere depuis les decorateurs de DTO" },
    { "module": "@nestjs/typeorm", "ref": "nest", "rationale": "Integration TypeORM officielle (repositories injectables, transactions)" },
    { "module": "typeorm", "ref": "typeorm", "rationale": "ORM. La ligne 1.x est desormais stable — la 0.3.31 est taguee `legacy` sur npm" },
    { "module": "@nestjs/jwt", "ref": "nest", "rationale": "Signature et verification des JWT" },
    { "module": "@nestjs/passport", "ref": "nest-passport", "rationale": "Pont Passport (strategies d'authentification)" },
    { "module": "passport", "ref": "passport" },
    { "module": "passport-jwt", "ref": "passport-jwt", "rationale": "Strategie JWT (Bearer)" },
    { "module": "argon2", "ref": "argon2", "rationale": "Hachage de mot de passe — Argon2id, retenu plutot que bcrypt (pas de compilation natif fragile, parametrage memoire)" },
    { "module": "reflect-metadata", "ref": "reflect-metadata", "rationale": "PEER OBLIGATOIRE — sans lui les decorateurs NestJS n'emettent aucune metadonnee et la DI echoue au demarrage" },
    { "module": "rxjs", "ref": "rxjs", "rationale": "Peer declare par @nestjs/core (^7.1.0) — interceptors et pipes reposent sur Observable" },
    { "module": "class-validator", "ref": "class-validator", "rationale": "Validation des DTO via ValidationPipe" },
    { "module": "class-transformer", "ref": "class-transformer", "rationale": "Peer de class-validator — transformation payload -> instance de DTO" },
    { "module": "helmet", "ref": "helmet", "rationale": "En-tetes HTTP de securite" },
    { "module": "pino", "ref": "pino", "rationale": "Logs structures — meme choix que backend/node-express" },
    { "module": "nestjs-pino", "ref": "nestjs-pino", "rationale": "Integration Nest (contexte de requete correle)" },
    { "module": "typescript", "ref": "typescript", "rationale": "PIN OBLIGATOIRE sur la ligne 6.0 — la 7.x est refusee par @nestjs/cli et ts-jest (cf. metadata.notes)" },
    { "module": "ts-node", "ref": "ts-node" },
    { "module": "tsconfig-paths", "ref": "tsconfig-paths" },
    { "module": "@nestjs/cli", "ref": "nest-cli", "rationale": "devDependency — build, generateurs, mode watch" },
    { "module": "@nestjs/schematics", "ref": "nest-schematics", "rationale": "devDependency — `nest generate resource`" },
    { "module": "@nestjs/testing", "ref": "nest", "rationale": "devDependency — Test.createTestingModule, cf. qa/node-vitest.md 10" },
    { "module": "jest", "ref": "jest", "rationale": "devDependency — runner par defaut de NestJS" },
    { "module": "ts-jest", "ref": "ts-jest", "rationale": "devDependency. C'est ce paquet qui plafonne TypeScript sous la 7" },
    { "module": "@types/node", "ref": "node-types" },
    { "module": "@types/express", "ref": "express-types", "rationale": "Ligne 5.x — coherente avec l'Express embarque par @nestjs/platform-express 12" },
    { "module": "@types/jest", "ref": "jest-types" },
    { "module": "eslint", "ref": "eslint" },
    { "module": "typescript-eslint", "ref": "typescript-eslint" },
    { "module": "prettier", "ref": "prettier" }
  ],
  "onDemand": [
    { "module": "pg", "ref": "pg", "capability": "postgres-driver", "triggers": ["postgres", "postgresql"], "rationale": "Driver PostgreSQL de TypeORM — requis des que DatabaseType=postgres" },
    { "module": "prisma", "ref": "prisma", "capability": "prisma-orm", "triggers": ["prisma"], "rationale": "ALTERNATIVE EXCLUSIVE a TypeORM — ne jamais livrer les deux. Pin 7.10.0 : le dist-tag npm `latest` pointe sur une prerelease 8.0.0-rc (cf. metadata.notes)", "alternative": true },
    { "module": "@prisma/client", "ref": "prisma", "capability": "prisma-orm", "triggers": ["prisma"], "rationale": "Client genere — DOIT etre a la meme version que le CLI `prisma`", "alternative": true },
    { "module": "@nestjs/platform-fastify", "ref": "nest", "capability": "fastify-adapter", "triggers": ["fastify", "haut.*debit", "performance.*http"], "rationale": "Adaptateur alternatif a Express. Exclusif de @nestjs/platform-express", "alternative": true },
    { "module": "@nestjs/throttler", "ref": "nest-throttler", "capability": "rate-limit", "triggers": ["rate.*limit", "throttle", "limitation.*debit", "anti.*abus"] },
    { "module": "@nestjs/terminus", "ref": "nest-terminus", "capability": "healthcheck", "triggers": ["health", "readiness", "liveness", "sonde"] },
    { "module": "@nestjs/cache-manager", "ref": "nest-cache", "capability": "cache", "triggers": ["cache", "mise.*en.*cache"] },
    { "module": "cache-manager", "ref": "cache-manager", "capability": "cache", "triggers": ["cache"], "rationale": "Peer de @nestjs/cache-manager" },
    { "module": "@nestjs/bullmq", "ref": "nest-bullmq", "capability": "background-jobs", "triggers": ["tache.*asynchrone", "background job", "worker", "file.*attente", "bullmq"] },
    { "module": "bullmq", "ref": "bullmq", "capability": "background-jobs", "triggers": ["background job", "bullmq", "worker"] },
    { "module": "ioredis", "ref": "ioredis", "capability": "background-jobs", "triggers": ["redis", "bullmq"], "rationale": "Backend Redis de BullMQ" },
    { "module": "@nestjs/event-emitter", "ref": "nest-event-emitter", "capability": "domain-events", "triggers": ["evenement.*domaine", "event.*emitter", "publication.*evenement"] },
    { "module": "@nestjs/microservices", "ref": "nest-microservices", "capability": "microservices", "triggers": ["microservice", "message.*broker", "rabbitmq", "kafka"] },
    { "module": "nestjs-zod", "ref": "nestjs-zod", "capability": "zod-validation", "triggers": ["\\bzod\\b", "schema.*zod"], "rationale": "Validation par Zod plutot que class-validator — utile pour partager les schemas avec un frontend TypeScript", "alternative": true },
    { "module": "zod", "ref": "zod", "capability": "zod-validation", "triggers": ["\\bzod\\b"], "alternative": true },
    { "module": "@sentry/nestjs", "ref": "sentry-nestjs", "capability": "sentry", "triggers": ["sentry", "error.*tracking", "monitoring.*erreurs"] },
    { "module": "passport-local", "ref": "passport-local", "capability": "auth-local", "triggers": ["login.*mot.*de.*passe", "auth-local", "connexion.*locale"] },
    { "module": "pino-http", "ref": "pino-http", "capability": "http-logging", "triggers": ["log.*requete", "access.*log"] },
    { "module": "pino-pretty", "ref": "pino-pretty", "capability": "http-logging", "triggers": ["log.*lisible", "pretty.*log"], "rationale": "dev uniquement — jamais en production (couteux, et casse le parsing JSON)" },
    { "module": "supertest", "ref": "supertest", "capability": "e2e-http", "triggers": ["test.*e2e", "supertest", "test.*endpoint"] },
    { "module": "@types/supertest", "ref": "supertest-types", "capability": "e2e-http", "triggers": ["supertest"] }
  ]
}
