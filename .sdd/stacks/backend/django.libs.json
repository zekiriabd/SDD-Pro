{
  "$schema": "../../templates/libs-catalog.schema.json",
  "stackId": "django",
  "category": "backend",
  "schemaVersion": 1,
  "buildSystem": "uv",
  "manifest": {
    "files": [
      "workspace/src/{BackendName}/pyproject.toml",
      "workspace/src/{BackendName}/manage.py",
      "workspace/src/{BackendName}/config/settings/base.py",
      "workspace/src/{BackendName}/config/urls.py",
      "workspace/src/{BackendName}/.env.example"
    ]
  },
  "metadata": {
    "lastUpdated": "2026-09-02",
    "runtime": "python 3.12",
    "framework": "django 5.2 LTS + Django REST Framework",
    "notes": "Stack backend API Django + DRF. CHOIX DE VERSION — Django 5.2 LTS et NON 6.1 : Django publie des LTS explicites (4.2, 5.2, puis 6.2), et `rules/library-and-stack.md 0` impose « runtime LTS only ». La 6.1.1 est la derniere version publiee mais n'est PAS une LTS ; la 5.2.17 est la LTS courante, supportee jusqu'en avril 2028. Bonus de coherence : tous les paquets de ce catalog declarent un classifier `Framework :: Django :: 5.2`, alors que plusieurs (drf-spectacular, django-redis, pytest-django, simplejwt) ne classifient pas encore 6.1. buildSystem=uv, aligne sur backend/python-fastapi. Ce stack cible une API REST ; pour du Django SSR avec templates, voir fullstack/django-templates."
  },
  "versions": {
    "python": "3.12",
    "django": "5.2.17",
    "djangorestframework": "3.18.0",
    "django-environ": "0.14.0",
    "psycopg": "3.3.5",
    "gunicorn": "26.2.0",
    "uvicorn": "0.52.4",
    "django-cors-headers": "4.9.0",
    "simplejwt": "5.5.1",
    "drf-spectacular": "0.30.0",
    "django-filter": "26.1",
    "whitenoise": "6.12.0",
    "structlog": "26.1.0",
    "django-structlog": "10.1.0",
    "celery": "5.6.3",
    "redis": "8.1.0",
    "django-redis": "7.0.0",
    "pillow": "12.3.0",
    "django-storages": "1.14.6",
    "sentry-sdk": "2.68.1",
    "django-debug-toolbar": "8.0.0",
    "django-extensions": "4.1",
    "django-allauth": "65.19.2",
    "django-anymail": "15.1",
    "django-health-check": "4.5.1",
    "django-silk": "5.5.2",
    "openpyxl": "3.1.5",
    "reportlab": "5.0.1",
    "ruff": "0.16.5",
    "mypy": "2.3.1",
    "django-stubs": "6.1.0",
    "drf-stubs": "3.18.1",
    "pytest": "9.1.1",
    "pytest-django": "4.14.0",
    "pytest-cov": "7.1.0",
    "model-bakery": "1.24.0",
    "factory-boy": "3.3.3"
  },
  "dbDrivers": {
    "postgres": { "module": "psycopg", "ref": "psycopg", "scope": "runtime" },
    "postgresql": { "module": "psycopg", "ref": "psycopg", "scope": "runtime" },
    "sqlite": { "module": "django", "ref": "django", "scope": "runtime" }
  },
  "core": [
    { "module": "django", "ref": "django", "rationale": "Framework — ligne LTS 5.2 (cf. metadata.notes)" },
    { "module": "djangorestframework", "ref": "djangorestframework", "rationale": "Couche API REST : serializers, ViewSets, routers, permissions" },
    { "module": "django-environ", "ref": "django-environ", "rationale": "Lecture typee de la configuration depuis l'environnement — evite os.environ dissemine dans settings" },
    { "module": "psycopg", "ref": "psycopg", "rationale": "Driver PostgreSQL v3 (psycopg2 est en maintenance). Le seul driver requis quand DatabaseType=postgres ; SQLite est integre a Django" },
    { "module": "django-cors-headers", "ref": "django-cors-headers", "rationale": "CORS — OBLIGATOIRE des que le front est sur une origine distincte (cf. rules/library-and-stack.md Partie B)" },
    { "module": "djangorestframework-simplejwt", "ref": "simplejwt", "rationale": "Authentification JWT (access + refresh, rotation, blacklist)" },
    { "module": "drf-spectacular", "ref": "drf-spectacular", "rationale": "Schema OpenAPI 3 genere depuis les serializers + Swagger UI" },
    { "module": "django-filter", "ref": "django-filter", "rationale": "Filtres de querystring declaratifs sur les ViewSets" },
    { "module": "gunicorn", "ref": "gunicorn", "rationale": "Serveur WSGI de production" },
    { "module": "whitenoise", "ref": "whitenoise", "rationale": "Service des fichiers statiques par l'app (pas de reverse proxy requis en conteneur)" },
    { "module": "structlog", "ref": "structlog", "rationale": "Logs structures — meme choix que backend/python-fastapi" },
    { "module": "django-structlog", "ref": "django-structlog", "rationale": "Integration Django (request_id correle sur toute la requete)" },
    { "module": "ruff", "ref": "ruff", "rationale": "Lint + format (dev)" },
    { "module": "mypy", "ref": "mypy", "rationale": "Typage statique (dev)" },
    { "module": "django-stubs", "ref": "django-stubs", "rationale": "Stubs Django pour mypy (dev) — sans eux, mypy ne comprend ni les managers ni les QuerySets" },
    { "module": "djangorestframework-stubs", "ref": "drf-stubs", "rationale": "Stubs DRF pour mypy (dev)" },
    { "module": "pytest", "ref": "pytest", "rationale": "Runner de tests (dev) — cf. qa/python-pytest.md" },
    { "module": "pytest-django", "ref": "pytest-django", "rationale": "Fixtures Django pour pytest (dev) : db, client, settings. Sans lui, pytest ne sait pas amorcer Django" }
  ],
  "onDemand": [
    { "module": "celery", "ref": "celery", "capability": "background-jobs", "triggers": ["tache.*asynchrone", "background job", "worker", "celery", "file.*attente"], "rationale": "Executeur de taches distribuees" },
    { "module": "redis", "ref": "redis", "capability": "background-jobs", "triggers": ["celery", "broker", "redis"], "rationale": "Broker de Celery et backend de cache" },
    { "module": "django-redis", "ref": "django-redis", "capability": "redis-cache", "triggers": ["cache", "redis", "mise.*en.*cache"], "rationale": "Backend de cache Django adosse a Redis" },
    { "module": "pillow", "ref": "pillow", "capability": "image-processing", "triggers": ["image", "upload.*photo", "miniature", "thumbnail"], "rationale": "Requis par ImageField — Django ne le tire PAS automatiquement" },
    { "module": "django-storages", "ref": "django-storages", "capability": "object-storage", "triggers": ["\\bs3\\b", "stockage.*objet", "azure.*blob", "upload.*cloud"] },
    { "module": "sentry-sdk", "ref": "sentry-sdk", "capability": "sentry", "triggers": ["sentry", "error.*tracking", "monitoring.*erreurs"] },
    { "module": "django-allauth", "ref": "django-allauth", "capability": "social-auth", "triggers": ["oauth", "connexion.*google", "sso", "allauth", "auth.*sociale"] },
    { "module": "django-anymail", "ref": "django-anymail", "capability": "transactional-email", "triggers": ["email.*transactionnel", "sendgrid", "mailgun", "envoi.*mail"] },
    { "module": "django-health-check", "ref": "django-health-check", "capability": "healthcheck", "triggers": ["health", "readiness", "liveness", "sonde"] },
    { "module": "django-debug-toolbar", "ref": "django-debug-toolbar", "capability": "dev-profiling", "triggers": ["debug.*toolbar", "profiler.*requetes", "n\\+1"], "rationale": "dev uniquement — a ne JAMAIS activer en production" },
    { "module": "django-silk", "ref": "django-silk", "capability": "dev-profiling", "triggers": ["silk", "profiling", "n\\+1"], "alternative": true },
    { "module": "django-extensions", "ref": "django-extensions", "capability": "dev-profiling", "triggers": ["shell_plus", "graph_models", "django-extensions"], "alternative": true },
    { "module": "openpyxl", "ref": "openpyxl", "capability": "excel", "triggers": ["excel", "xlsx", "export.*tableur"] },
    { "module": "reportlab", "ref": "reportlab", "capability": "pdf", "triggers": ["\\bpdf\\b", "generation.*document", "export.*pdf"] },
    { "module": "uvicorn", "ref": "uvicorn", "capability": "asgi", "triggers": ["websocket", "asgi", "async.*view", "temps.*reel"], "rationale": "Serveur ASGI — requis pour les vues async et les WebSockets ; gunicorn seul est WSGI" },
    { "module": "pytest-cov", "ref": "pytest-cov", "capability": "coverage", "triggers": ["coverage", "couverture.*tests"] },
    { "module": "model-bakery", "ref": "model-bakery", "capability": "test-fixtures", "triggers": ["fixture", "donnees.*test", "factory", "baker"], "rationale": "Instancie un modele et TOUTES ses relations obligatoires en un appel" },
    { "module": "factory-boy", "ref": "factory-boy", "capability": "test-fixtures", "triggers": ["factory_boy", "factory"], "alternative": true }
  ]
}
