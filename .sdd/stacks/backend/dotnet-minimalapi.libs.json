{
  "$schema": "../../templates/libs-catalog.schema.json",
  "stackId": "dotnet-minimalapi",
  "category": "backend",
  "schemaVersion": 1,
  "buildSystem": "dotnet",
  "manifest": {
    "files": [
      "workspace/src/{BackendName}/{BackendName}.csproj"
    ]
  },
  "versions": {
    "ef-core": "10.0.11",
    "ef-core-sqlserver": "10.0.11",
    "ef-core-sqlite": "10.0.11",
    "npgsql-ef": "10.0.3",
    "pomelo-mysql": "9.0.0",
    "oracle-ef": "10.23.26300",
    "mongodb-ef": "10.0.3",
    "automapper": "16.2.0",
    "serilog-aspnetcore": "10.0.0",
    "serilog-sinks-console": "6.1.1",
    "swashbuckle": "10.2.3",
    "asp-versioning": "10.2.3",
    "microsoft-openapi": "3.10.2",
    "microsoft-identity-web": "4.14.2",
    "fluentvalidation": "12.1.1",
    "fluentvalidation-aspnetcore": "11.3.1",
    "polly": "8.7.0",
    "http-resilience": "10.9.0",
    "caching-memory": "10.0.11",
    "asp-openapi": "10.0.11",
    "epplus": "8.7.0",
    "closedxml": "0.105.1",
    "questpdf": "2026.8.0",
    "itext7": "9.7.0",
    "mediatr": "14.2.0",
    "stackexchange-redis": "3.1.31",
    "caching-redis": "10.0.11",
    "mapster": "10.0.12",
    "mailkit": "4.17.0",
    "mimekit": "4.17.0",
    "bcrypt-net": "4.2.1",
    "jwt-bearer": "10.0.11",
    "ef-core-mysql-lcd": "9.0.4"
  },
  "dbDrivers": {
    "sqlserver": {
      "module": "Microsoft.EntityFrameworkCore.SqlServer",
      "ref": "ef-core-sqlserver",
      "providerName": "Microsoft.EntityFrameworkCore.SqlServer",
      "useExtension": "UseSqlServer"
    },
    "postgres": {
      "module": "Npgsql.EntityFrameworkCore.PostgreSQL",
      "ref": "npgsql-ef",
      "providerName": "Npgsql.EntityFrameworkCore.PostgreSQL",
      "useExtension": "UseNpgsql"
    },
    "postgresql": {
      "module": "Npgsql.EntityFrameworkCore.PostgreSQL",
      "ref": "npgsql-ef",
      "providerName": "Npgsql.EntityFrameworkCore.PostgreSQL",
      "useExtension": "UseNpgsql"
    },
    "mysql": {
      "module": "Pomelo.EntityFrameworkCore.MySql",
      "ref": "pomelo-mysql",
      "providerName": "Pomelo.EntityFrameworkCore.MySql",
      "useExtension": "UseMySql",
      "efCoreVersionOverride": "9.0.4"
    },
    "mariadb": {
      "module": "Pomelo.EntityFrameworkCore.MySql",
      "ref": "pomelo-mysql",
      "providerName": "Pomelo.EntityFrameworkCore.MySql",
      "useExtension": "UseMySql",
      "efCoreVersionOverride": "9.0.4"
    },
    "sqlite": {
      "module": "Microsoft.EntityFrameworkCore.Sqlite",
      "ref": "ef-core-sqlite",
      "providerName": "Microsoft.EntityFrameworkCore.Sqlite",
      "useExtension": "UseSqlite"
    },
    "oracle": {
      "module": "Oracle.EntityFrameworkCore",
      "ref": "oracle-ef",
      "providerName": "Oracle.EntityFrameworkCore",
      "useExtension": "UseOracle"
    },
    "mongodb": {
      "module": "MongoDB.EntityFrameworkCore",
      "ref": "mongodb-ef",
      "providerName": "MongoDB.EntityFrameworkCore",
      "useExtension": "UseMongoDB"
    }
  },
  "core": [
    {
      "module": "Microsoft.EntityFrameworkCore",
      "ref": "ef-core"
    },
    {
      "module": "Microsoft.EntityFrameworkCore.Design",
      "ref": "ef-core"
    },
    {
      "module": "Microsoft.EntityFrameworkCore.Tools",
      "ref": "ef-core"
    },
    {
      "module": "Microsoft.AspNetCore.OpenApi",
      "ref": "asp-openapi"
    },
    {
      "module": "AutoMapper",
      "ref": "automapper"
    },
    {
      "module": "Serilog.AspNetCore",
      "ref": "serilog-aspnetcore"
    },
    {
      "module": "Serilog.Sinks.Console",
      "ref": "serilog-sinks-console"
    },
    {
      "module": "Swashbuckle.AspNetCore",
      "ref": "swashbuckle"
    },
    {
      "module": "Swashbuckle.AspNetCore.Annotations",
      "ref": "swashbuckle"
    },
    {
      "module": "Asp.Versioning.Http",
      "ref": "asp-versioning"
    },
    {
      "module": "Asp.Versioning.Mvc.ApiExplorer",
      "ref": "asp-versioning"
    },
    {
      "module": "Microsoft.OpenApi",
      "ref": "microsoft-openapi"
    },
    {
      "module": "Microsoft.Identity.Web",
      "ref": "microsoft-identity-web"
    },
    {
      "module": "FluentValidation",
      "ref": "fluentvalidation"
    },
    {
      "module": "FluentValidation.AspNetCore",
      "ref": "fluentvalidation-aspnetcore"
    },
    {
      "module": "FluentValidation.DependencyInjectionExtensions",
      "ref": "fluentvalidation"
    },
    {
      "module": "Polly",
      "ref": "polly"
    },
    {
      "module": "Microsoft.Extensions.Http.Resilience",
      "ref": "http-resilience"
    },
    {
      "module": "Microsoft.Extensions.Caching.Memory",
      "ref": "caching-memory"
    }
  ],
  "onDemand": [
    {
      "module": "EPPlus",
      "ref": "epplus",
      "capability": "excel",
      "triggers": [
        "\\bexcel\\b",
        "\\.xlsx\\b",
        "export.*excel",
        "import.*excel",
        "tableur"
      ]
    },
    {
      "module": "ClosedXML",
      "ref": "closedxml",
      "capability": "excel",
      "triggers": [
        "\\bexcel\\b",
        "\\.xlsx\\b",
        "export.*excel",
        "import.*excel",
        "tableur"
      ],
      "alternative": true
    },
    {
      "module": "QuestPDF",
      "ref": "questpdf",
      "capability": "pdf",
      "triggers": [
        "\\bpdf\\b",
        "\\.pdf\\b",
        "export.*pdf",
        "generer.*pdf",
        "imprim"
      ]
    },
    {
      "module": "itext7",
      "ref": "itext7",
      "capability": "pdf",
      "triggers": [
        "\\bpdf\\b",
        "\\.pdf\\b",
        "export.*pdf",
        "generer.*pdf",
        "imprim"
      ],
      "alternative": true
    },
    {
      "module": "MediatR",
      "ref": "mediatr",
      "capability": "cqrs",
      "triggers": [
        "\\bcqrs\\b",
        "mediatr",
        "command.*handler",
        "query.*handler"
      ]
    },
    {
      "module": "StackExchange.Redis",
      "ref": "stackexchange-redis",
      "capability": "redis-cache",
      "triggers": [
        "\\bredis\\b",
        "cache distribu",
        "distributed cache"
      ]
    },
    {
      "module": "Microsoft.Extensions.Caching.StackExchangeRedis",
      "ref": "caching-redis",
      "capability": "redis-cache",
      "triggers": [
        "\\bredis\\b",
        "cache distribu",
        "distributed cache"
      ]
    },
    {
      "module": "Mapster",
      "ref": "mapster",
      "capability": "fast-mapping",
      "triggers": [
        "mapster\\b",
        "mapping perf",
        "high.?performance.*mapp"
      ]
    },
    {
      "module": "MailKit",
      "ref": "mailkit",
      "capability": "email",
      "triggers": [
        "\\bsmtp\\b",
        "envoi.*email",
        "envoi.*courriel",
        "send.*email",
        "email.*notification",
        "notification.*par.*email",
        "mail.*confirmation",
        "verifier.*email"
      ]
    },
    {
      "module": "MimeKit",
      "ref": "mimekit",
      "capability": "email",
      "triggers": [
        "\\bsmtp\\b",
        "envoi.*email",
        "envoi.*courriel",
        "send.*email",
        "email.*notification",
        "notification.*par.*email",
        "mail.*confirmation",
        "verifier.*email"
      ]
    },
    {
      "module": "BCrypt.Net-Next",
      "ref": "bcrypt-net",
      "capability": "auth-local",
      "triggers": [
        "bcrypt",
        "password.*hash",
        "hash.*password",
        "motdepasse.*hash",
        "mot.*passe.*hash",
        "auth-local",
        "password_hash",
        "verify.*password",
        "connexion.*mot.*passe",
        "inscription",
        "register.*user"
      ]
    },
    {
      "module": "Microsoft.AspNetCore.Authentication.JwtBearer",
      "ref": "jwt-bearer",
      "capability": "auth-local",
      "triggers": [
        "\\bjwt\\b",
        "jsonwebtoken",
        "bearer.*token",
        "auth-local",
        "issue.*token",
        "verify.*token",
        "validate.*token",
        "jwt.*authent",
        "token.*authent",
        "authorize.*attribute",
        "\\[Authorize\\]"
      ]
    }
  ],
  "plugins": [],
  "metadata": {
    "lastUpdated": "2026-09-02",
    "format": "compact (v2)",
    "changeLog": [
      "2026-05-22 — fix: removed hardcoded EF.SqlServer from core[] (was installed for ALL projects regardless of DatabaseType). Expanded dbDrivers from 1 → 7 entries (sqlserver, postgres, mysql, mariadb, sqlite, oracle, mongodb). Pinned ef-core 10.0.6 → 9.0.4 (LCD across all drivers since Npgsql.EF 10.x is preview only). Post-mortem DemoApp 2026-05-22: NU1608 EF 10.0.6 vs Npgsql.EF 9.0.4 became runtime MissingMethodException on first DbSet access.",
      "2026-06-07 — Audit CTO 2026-06-07 : revert ef-core 10.0.0 → 9.0.4 (drift post-mortem DemoApp 2026-05-22 re-introduced silently).",
      "2026-09-02 — Audit backend : EF Core 9.0.4 -> 10.0.11. Le pin en 9.x etait justifie par « Npgsql.EF 10.x est preview-only » (post-mortem DemoApp 2026-05-22, NU1608 -> MissingMethodException) ; cette cause a disparu — Npgsql.EF 10.0.3 est STABLE, de meme que SqlServer/Sqlite 10.0.11, Oracle 10.23.26300 et MongoDB 10.0.3. Le catalog etait par ailleurs INCOHERENT : EF Core 9.0.4 cohabitait avec des paquets ASP.NET 10.x (asp-openapi, http-resilience, caching-memory, jwt-bearer) sur un TFM net10.0. CONTRAINTE RESIDUELLE : Pomelo.EntityFrameworkCore.MySql n'a AUCUNE version 10.x publiee (derniere stable 9.0.0) -> pour DatabaseType=mysql|mariadb, EF Core DOIT rester en 9.0.4 (ref ef-core-mysql-lcd + dbDrivers[].efCoreVersionOverride). Melanger EF 10 et Pomelo 9 reproduit exactement le NU1608 du post-mortem."
    ]
  }
}
