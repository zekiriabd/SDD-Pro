{
  "$schema": "../../templates/libs-catalog.schema.json",
  "stackId": "python-fastapi",
  "category": "backend",
  "schemaVersion": 1,
  "buildSystem": "uv",
  "manifest": {
    "files": [
      "workspace/src/{BackendName}/pyproject.toml",
      "workspace/src/{BackendName}/uv.lock"
    ]
  },
  "versions": {
    "python": "3.12",
    "fastapi": "0.141.1",
    "uvicorn": "0.52.4",
    "pydantic": "2.13.5",
    "pydantic-settings": "2.15.0",
    "sqlalchemy": "2.0.52",
    "alembic": "1.19.1",
    "asyncpg": "0.31.0",
    "aiomysql": "0.2.0",
    "aioodbc": "0.5.0",
    "aiosqlite": "0.22.1",
    "structlog": "26.1.0",
    "python-json-logger": "2.0.7",
    "httpx": "0.28.1",
    "tenacity": "9.1.4",
    "fastapi-pagination": "0.15.16",
    "slowapi": "0.1.10",
    "python-multipart": "0.0.32",
    "babel": "2.18.0",
    "pyjwt": "2.13.0",
    "argon2-cffi": "25.1.0",
    "email-validator": "2.3.0",
    "openpyxl": "3.1.5",
    "reportlab": "5.0.1",
    "ruff": "0.16.5",
    "mypy": "2.3.1"
  },
  "dbDrivers": {
    "postgres": {
      "module": "asyncpg",
      "ref": "asyncpg"
    },
    "mysql": {
      "module": "aiomysql",
      "ref": "aiomysql"
    },
    "sqlserver": {
      "module": "aioodbc",
      "ref": "aioodbc"
    },
    "sqlite": {
      "module": "aiosqlite",
      "ref": "aiosqlite"
    }
  },
  "core": [
    {
      "module": "fastapi",
      "ref": "fastapi"
    },
    {
      "module": "uvicorn[standard]",
      "ref": "uvicorn"
    },
    {
      "module": "pydantic",
      "ref": "pydantic"
    },
    {
      "module": "pydantic-settings",
      "ref": "pydantic-settings"
    },
    {
      "module": "sqlalchemy[asyncio]",
      "ref": "sqlalchemy"
    },
    {
      "module": "alembic",
      "ref": "alembic"
    },
    {
      "module": "structlog",
      "ref": "structlog"
    },
    {
      "module": "python-json-logger",
      "ref": "python-json-logger"
    },
    {
      "module": "httpx",
      "ref": "httpx"
    },
    {
      "module": "tenacity",
      "ref": "tenacity"
    },
    {
      "module": "fastapi-pagination",
      "ref": "fastapi-pagination"
    },
    {
      "module": "slowapi",
      "ref": "slowapi"
    },
    {
      "module": "python-multipart",
      "ref": "python-multipart"
    },
    {
      "module": "babel",
      "ref": "babel"
    },
    {
      "module": "email-validator",
      "ref": "email-validator"
    },
    {
      "module": "ruff",
      "ref": "ruff"
    },
    {
      "module": "mypy",
      "ref": "mypy"
    }
  ],
  "onDemand": [
    {
      "module": "argon2-cffi",
      "ref": "argon2-cffi",
      "capability": "auth-local",
      "rationale": "Argon2 password hashing — winner Password Hashing Competition 2015, maintained, replaces passlib 1.7.4 (non maintenu 2020) + bcrypt deprecation drift (audit CTO 2026-06-07).",
      "triggers": [
        "auth-local",
        "hash.*password",
        "bcrypt",
        "argon2"
      ]
    },
    {
      "module": "pyjwt[crypto]",
      "ref": "pyjwt",
      "capability": "jwt",
      "rationale": "JWT encode/decode RFC 7519. Remplace python-jose 3.3.0 (CVE-2024-33663 algorithm confusion + CVE-2024-33664 JWT bomb, package unmaintained 2021) — audit CTO 2026-06-07.",
      "triggers": [
        "\\bjwt\\b",
        "jose",
        "auth-local",
        "auth-azure-ad"
      ]
    },
    {
      "module": "openpyxl",
      "ref": "openpyxl",
      "capability": "excel",
      "triggers": [
        "\\bexcel\\b",
        "\\.xlsx\\b",
        "export.*excel",
        "import.*excel",
        "tableur"
      ]
    },
    {
      "module": "reportlab",
      "ref": "reportlab",
      "capability": "pdf",
      "triggers": [
        "\\bpdf\\b",
        "\\.pdf\\b",
        "export.*pdf",
        "generer.*pdf",
        "imprim"
      ]
    }
  ],
  "plugins": [],
  "metadata": {
    "lastUpdated": "2026-09-02",
    "format": "compact (v2) â€” DB drivers moved to top-level dbDrivers",
    "changeLog": [
      "2026-09-02 — Audit backend. Catalog rebase depuis PyPI (etait fige au 2026-05-07). Deux points d'attention : (1) `python-json-logger` 2.0.7 est CONSERVE tel quel — c'est le dernier de sa ligne 2.x et structlog 26.x le remplace fonctionnellement ; il ne reste que pour le formatage JSON en sortie stdlib. (2) `reportlab` passe en majeure 4 -> 5 : c'est la seule majeure appliquee ici, la lib n'etant utilisee que par la capability `pdf` (surface reduite, pas d'API traversant le code applicatif). Le runtime Python reste pinne 3.12 (matrice LTS de rules/library-and-stack.md 0)."
    ]
  }
}
