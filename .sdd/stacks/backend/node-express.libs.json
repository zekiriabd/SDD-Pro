{
  "$schema": "../../templates/libs-catalog.schema.json",
  "stackId": "node-express",
  "category": "backend",
  "schemaVersion": 1,
  "buildSystem": "pnpm",
  "manifest": {
    "files": [
      "workspace/src/{BackendName}/package.json",
      "workspace/src/{BackendName}/tsconfig.json"
    ]
  },
  "versions": {
    "express": "4.22.2",
    "prisma": "7.10.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "zod": "4.5.4",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "helmet": "8.3.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "uuid": "14.0.2",
    "dayjs": "1.11.23",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "bcrypt": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "axios": "1.20.0",
    "axios-retry": "4.5.0",
    "exceljs": "4.4.0",
    "pdfkit": "0.20.2",
    "multer": "2.3.0",
    "compression": "1.8.1",
    "express-rate-limit": "8.7.0",
    "typescript": "6.0.3",
    "ts-node-dev": "2.0.0",
    "tsc-alias": "1.9.4",
    "node-types": "26.4.1",
    "express-types": "4.17.25",
    "cors-types": "2.8.19",
    "uuid-types": "10.0.0",
    "swagger-jsdoc-types": "6.0.4",
    "swagger-ui-types": "4.1.7",
    "bcrypt-types": "6.0.0",
    "jsonwebtoken-types": "9.0.10",
    "multer-types": "2.2.0",
    "eslint": "10.9.1",
    "typescript-eslint": "8.69.0"
  },
  "core": [
    {
      "module": "express",
      "ref": "express"
    },
    {
      "module": "prisma",
      "ref": "prisma"
    },
    {
      "module": "@prisma/client",
      "ref": "prisma"
    },
    {
      "module": "pino",
      "ref": "pino"
    },
    {
      "module": "pino-http",
      "ref": "pino-http"
    },
    {
      "module": "pino-pretty",
      "ref": "pino-pretty"
    },
    {
      "module": "zod",
      "ref": "zod"
    },
    {
      "module": "swagger-jsdoc",
      "ref": "swagger-jsdoc"
    },
    {
      "module": "swagger-ui-express",
      "ref": "swagger-ui-express"
    },
    {
      "module": "helmet",
      "ref": "helmet"
    },
    {
      "module": "cors",
      "ref": "cors"
    },
    {
      "module": "dotenv",
      "ref": "dotenv"
    },
    {
      "module": "compression",
      "ref": "compression"
    },
    {
      "module": "express-rate-limit",
      "ref": "express-rate-limit"
    },
    {
      "module": "typescript",
      "ref": "typescript"
    },
    {
      "module": "ts-node-dev",
      "ref": "ts-node-dev"
    },
    {
      "module": "tsc-alias",
      "ref": "tsc-alias"
    },
    {
      "module": "@types/node",
      "ref": "node-types"
    },
    {
      "module": "@types/express",
      "ref": "express-types"
    },
    {
      "module": "@types/cors",
      "ref": "cors-types"
    },
    {
      "module": "@types/swagger-jsdoc",
      "ref": "swagger-jsdoc-types"
    },
    {
      "module": "@types/swagger-ui-express",
      "ref": "swagger-ui-types"
    },
    {
      "module": "eslint",
      "ref": "eslint"
    },
    {
      "module": "typescript-eslint",
      "ref": "typescript-eslint"
    }
  ],
  "onDemand": [
    {
      "module": "uuid",
      "ref": "uuid",
      "capability": "uuid-gen",
      "triggers": [
        "\\buuid\\b",
        "guid.*genere",
        "id.*aleatoire"
      ]
    },
    {
      "module": "@types/uuid",
      "ref": "uuid-types",
      "capability": "uuid-gen",
      "triggers": [
        "\\buuid\\b",
        "guid.*genere",
        "id.*aleatoire"
      ]
    },
    {
      "module": "dayjs",
      "ref": "dayjs",
      "capability": "date-utils",
      "triggers": [
        "dates.*format",
        "duree",
        "intervalle.*temps"
      ]
    },
    {
      "module": "bcrypt",
      "ref": "bcrypt",
      "capability": "auth-local",
      "triggers": [
        "auth-local",
        "hash.*password",
        "bcrypt"
      ],
      "rationale": "Native bcrypt (kelektiv/node.bcrypt.js) — bcryptjs deprecated upstream 2025, ~10x plus rapide donc cost factor sain"
    },
    {
      "module": "@types/bcrypt",
      "ref": "bcrypt-types",
      "capability": "auth-local",
      "triggers": [
        "auth-local",
        "hash.*password",
        "bcrypt"
      ]
    },
    {
      "module": "jsonwebtoken",
      "ref": "jsonwebtoken",
      "capability": "jwt",
      "triggers": [
        "\\bjwt\\b",
        "auth-local",
        "auth-azure-ad"
      ]
    },
    {
      "module": "@types/jsonwebtoken",
      "ref": "jsonwebtoken-types",
      "capability": "jwt",
      "triggers": [
        "\\bjwt\\b",
        "auth-local",
        "auth-azure-ad"
      ]
    },
    {
      "module": "axios",
      "ref": "axios",
      "capability": "http-client",
      "triggers": [
        "\\baxios\\b",
        "appel.*api.*externe",
        "service.*externe",
        "third.party"
      ]
    },
    {
      "module": "axios-retry",
      "ref": "axios-retry",
      "capability": "http-client",
      "triggers": [
        "\\baxios\\b",
        "retry.*http",
        "resilience"
      ]
    },
    {
      "module": "exceljs",
      "ref": "exceljs",
      "capability": "excel",
      "triggers": [
        "\\bexcel\\b",
        "\\.xlsx\\b",
        "export.*excel",
        "import.*excel",
        "tableur"
      ]
    },
    {
      "module": "pdfkit",
      "ref": "pdfkit",
      "capability": "pdf",
      "triggers": [
        "\\bpdf\\b",
        "\\.pdf\\b",
        "export.*pdf",
        "generer.*pdf"
      ]
    },
    {
      "module": "multer",
      "ref": "multer",
      "capability": "file-upload",
      "triggers": [
        "upload.*fichier",
        "multipart",
        "form-data"
      ]
    },
    {
      "module": "@types/multer",
      "ref": "multer-types",
      "capability": "file-upload",
      "triggers": [
        "upload.*fichier",
        "multipart",
        "form-data"
      ]
    },
    {
      "module": "class-transformer",
      "ref": "class-transformer",
      "capability": "object-mapping",
      "triggers": [
        "class-transformer",
        "auto.*mapping",
        "dto.*mapping"
      ]
    },
    {
      "module": "class-validator",
      "ref": "class-validator",
      "capability": "decorator-validation",
      "triggers": [
        "class-validator",
        "decorator.*validation"
      ],
      "alternative": true
    }
  ],
  "plugins": [],
  "metadata": {
    "lastUpdated": "2026-09-02",
    "format": "compact (v2)",
    "changeLog": [
      "2026-09-02 — Audit backend. Bumps de patch/minor dans les lignes majeures en place. Express MAINTENU sur la ligne 4 (4.21.2 -> 4.22.2) : la 5.2.1 est publiee et npm expose un dist-tag `latest-4` (4.22.2), donc la ligne 4 est toujours maintenue en amont ; Express 5 change le routage, la propagation d'erreurs async et retire des API — majeure non appliquee sur un stack bench-validated, cf. .md 2.3.1. Prisma 6.1.0 -> 7.10.0 : ATTENTION, le dist-tag npm `latest` de `prisma` pointe sur 8.0.0-rc.12 (PRERELEASE) ; la derniere stable est la 7.10.0, exposee par le dist-tag `prev`. TypeScript pinne sur 6.0.3 et non 7.0.2 (cf. .md 2.3.1).",
      "2026-09-02 — BUG corrige : `@types/express` etait pinne en 5.0.0 alors qu'`express` etait en 4.21.2. Les typings 5.x decrivent l'API d'Express 5 (signatures de Router, RequestHandler, propagation d'erreurs) et NON celle d'Express 4 : le compilateur validait donc du code contre un runtime different de celui installe. Realigne sur 4.17.25, la ligne @types correspondant a Express 4."
    ]
  }
}
