{
  "$schema": "../../templates/libs-catalog.schema.json",
  "stackId": "flutter",
  "category": "mobiles",
  "schemaVersion": 1,
  "buildSystem": "pub",
  "manifest": {
    "files": [
      "workspace/src/{AppName}/pubspec.yaml",
      "workspace/src/{AppName}/analysis_options.yaml",
      "workspace/src/{AppName}/build.yaml",
      "workspace/src/{AppName}/lib/main.dart",
      "workspace/src/{AppName}/android/app/build.gradle.kts",
      "workspace/src/{AppName}/ios/Runner/Info.plist"
    ]
  },
  "metadata": {
    "lastUpdated": "2026-09-02",
    "platforms": ["android", "ios"],
    "optionalPlatforms": ["web", "windows", "macos", "linux"],
    "workflow": "single-project-multi-target",
    "toolchain": {
      "flutter": "3.47.2",
      "dart": "3.13.2",
      "channel": "stable",
      "releasedAt": "2026-08-27",
      "sdkConstraint": "^3.13.0",
      "minAndroidSdk": 24,
      "minIosVersion": "15.0"
    },
    "notes": "Stack mobile cross-platform Flutter. UI declarative Dart compilee AOT en ARM natif, rendu par Impeller. Consomme un backend separe declare en ## Active Tech Specs. buildSystem='pub' (flutter pub add -> pubspec.yaml). CONTRAINTE SDK : `environment.sdk` doit etre `^3.13.0` — c'est le plancher de freezed 4.0.1, le plus strict du catalog. Flutter 3.47.2 (stable, 2026-08-27) embarque Dart 3.13.2, ce qui le satisfait tout juste. Les paquets `flutter_test` et `integration_test` viennent du SDK (`sdk: flutter`) et n'ont donc PAS de version pub — ils n'apparaissent pas dans ce catalog, cf. .md 2.4.c. La famille Riverpod est co-versionnee : flutter_riverpod 3.4.2 / riverpod_annotation 4.0.6 / riverpod_generator 4.0.8 / riverpod_lint 3.1.8 epinglent toutes `riverpod: 3.4.2` — bumper l'une sans les autres casse la resolution."
  },
  "versions": {
    "flutter-riverpod": "3.4.2",
    "riverpod-annotation": "4.0.6",
    "riverpod-generator": "4.0.8",
    "riverpod-lint": "3.1.8",
    "custom-lint": "0.8.1",
    "go-router": "18.0.0",
    "dio": "5.11.0",
    "freezed": "4.0.1",
    "freezed-annotation": "3.1.0",
    "json-serializable": "6.14.1",
    "json-annotation": "4.12.0",
    "build-runner": "2.16.1",
    "flutter-lints": "6.0.0",
    "very-good-analysis": "10.3.0",
    "shared-preferences": "2.5.5",
    "flutter-secure-storage": "11.0.0",
    "intl": "0.20.3",
    "logger": "2.7.0",
    "talker": "5.1.20",
    "collection": "1.19.1",
    "get-it": "9.2.1",
    "drift": "2.34.4",
    "drift-dev": "2.34.6",
    "sqlite3": "3.5.2",
    "path-provider": "2.1.6",
    "cached-network-image": "4.0.0",
    "flutter-svg": "2.3.0",
    "image-picker": "1.2.3",
    "camera": "0.12.0+2",
    "geolocator": "14.0.3",
    "google-maps": "2.18.0",
    "permission-handler": "13.0.1",
    "local-auth": "3.0.2",
    "firebase-core": "4.14.0",
    "firebase-messaging": "16.6.0",
    "flutter-local-notifications": "22.3.0",
    "sentry-flutter": "9.28.0",
    "url-launcher": "6.3.2",
    "webview-flutter": "4.14.1",
    "connectivity-plus": "7.3.1",
    "package-info-plus": "10.2.1",
    "device-info-plus": "13.2.0",
    "flutter-stripe": "14.0.0",
    "fl-chart": "1.2.0",
    "flutter-bloc": "9.1.1",
    "bloc": "9.2.1",
    "equatable": "2.1.0",
    "mocktail": "1.0.5",
    "patrol": "4.9.0"
  },
  "core": [
    { "module": "flutter_riverpod", "ref": "flutter-riverpod", "rationale": "State management + DI — defaut SDD_Pro. Compile-safe, testable sans widget tree, remplace Provider/InheritedWidget" },
    { "module": "riverpod_annotation", "ref": "riverpod-annotation", "rationale": "Annotations @riverpod (providers generes, typage exact)" },
    { "module": "go_router", "ref": "go-router", "rationale": "Routing declaratif officiel Flutter — deep links, redirections de garde auth, routes typees" },
    { "module": "dio", "ref": "dio", "rationale": "Client HTTP — interceptors (auth, retry, log), timeouts, annulation. Le package `http` du SDK n'a aucun de ces mecanismes" },
    { "module": "freezed_annotation", "ref": "freezed-annotation", "rationale": "Annotations de modeles immuables + unions scellees (sealed) pour les etats UI" },
    { "module": "json_annotation", "ref": "json-annotation", "rationale": "Annotations (de)serialisation JSON" },
    { "module": "flutter_secure_storage", "ref": "flutter-secure-storage", "rationale": "Tokens JWT / secrets (Keychain iOS, Keystore Android) — JAMAIS shared_preferences" },
    { "module": "shared_preferences", "ref": "shared-preferences", "rationale": "Preferences NON sensibles (theme, derniere page, flags UI)" },
    { "module": "intl", "ref": "intl", "rationale": "Formatage dates / nombres / devises par locale" },
    { "module": "logger", "ref": "logger", "rationale": "Logs structures — `print()` est interdit (cf. .md 5)" },
    { "module": "collection", "ref": "collection", "rationale": "firstWhereOrNull, groupBy, comparaisons profondes — absents de dart:core" },
    { "module": "build_runner", "ref": "build-runner", "rationale": "Orchestrateur de codegen (dev_dependency) — requis par freezed, json_serializable et riverpod_generator" },
    { "module": "freezed", "ref": "freezed", "rationale": "Generateur des modeles immuables (dev_dependency). Plancher Dart >=3.13.0 : c'est lui qui fixe `environment.sdk` du projet" },
    { "module": "json_serializable", "ref": "json-serializable", "rationale": "Generateur fromJson/toJson (dev_dependency)" },
    { "module": "riverpod_generator", "ref": "riverpod-generator", "rationale": "Generateur des providers @riverpod (dev_dependency)" },
    { "module": "riverpod_lint", "ref": "riverpod-lint", "rationale": "Lints Riverpod (dev_dependency) — detecte un ref.watch hors build, un provider non dispose" },
    { "module": "custom_lint", "ref": "custom-lint", "rationale": "Moteur requis par riverpod_lint (dev_dependency) — sans lui les lints Riverpod ne s'executent pas" },
    { "module": "flutter_lints", "ref": "flutter-lints", "rationale": "Jeu de lints officiel Flutter (dev_dependency), reference dans analysis_options.yaml" },
    { "module": "mocktail", "ref": "mocktail", "rationale": "Mocking sans codegen (dev_dependency) — retenu plutot que mockito, qui exige un build_runner par classe mockee" }
  ],
  "onDemand": [
    { "module": "drift", "ref": "drift", "capability": "offline-db", "triggers": ["sqlite", "offline-first", "base.*locale", "persistance.*locale", "drift"], "rationale": "ORM SQLite typage-fort avec requetes compile-safe" },
    { "module": "drift_dev", "ref": "drift-dev", "capability": "offline-db", "triggers": ["sqlite", "offline-first", "drift"], "rationale": "Generateur Drift (dev_dependency)" },
    { "module": "sqlite3", "ref": "sqlite3", "capability": "offline-db", "triggers": ["sqlite", "offline-first", "drift"], "rationale": "Bibliotheques natives SQLite. ATTENTION : remplace `sqlite3_flutter_libs`, dont la derniere version publiee est `0.6.0+eol` (« Not used anymore, update to version 3.x of package:sqlite3 instead »). Ne PAS pinner l'ancien paquet" },
    { "module": "path_provider", "ref": "path-provider", "capability": "offline-db", "triggers": ["sqlite", "chemin.*fichier", "documents.*directory", "stockage.*fichier"], "rationale": "Resout le repertoire ou poser le fichier .sqlite" },
    { "module": "cached_network_image", "ref": "cached-network-image", "capability": "image-loading", "triggers": ["image.*distante", "avatar", "vignette", "cache.*image"] },
    { "module": "flutter_svg", "ref": "flutter-svg", "capability": "svg", "triggers": ["svg", "icone.*vectorielle", "vector.*graphics"] },
    { "module": "image_picker", "ref": "image-picker", "capability": "image-picker", "triggers": ["gallerie", "choisir.*photo", "image-picker"] },
    { "module": "camera", "ref": "camera", "capability": "camera", "triggers": ["camera", "photo", "video.*capture"] },
    { "module": "geolocator", "ref": "geolocator", "capability": "location", "triggers": ["gps", "geolocalisation", "position.*utilisateur"] },
    { "module": "google_maps_flutter", "ref": "google-maps", "capability": "maps", "triggers": ["maps", "carte", "marker", "google.*maps"] },
    { "module": "permission_handler", "ref": "permission-handler", "capability": "permissions", "triggers": ["permission", "autorisation.*runtime"], "rationale": "Demande de permission juste-a-temps. Requis des qu'une capability camera / location / notifications est active" },
    { "module": "local_auth", "ref": "local-auth", "capability": "biometric", "triggers": ["biometric", "face-id", "touch-id", "empreinte"] },
    { "module": "firebase_core", "ref": "firebase-core", "capability": "push", "triggers": ["push.*notification", "fcm", "firebase"], "rationale": "Prerequis de tout module Firebase" },
    { "module": "firebase_messaging", "ref": "firebase-messaging", "capability": "push", "triggers": ["push.*notification", "fcm", "notification.*distante"] },
    { "module": "flutter_local_notifications", "ref": "flutter-local-notifications", "capability": "local-notification", "triggers": ["notification.*locale", "rappel", "reminder", "notification.*planifiee"] },
    { "module": "sentry_flutter", "ref": "sentry-flutter", "capability": "sentry", "triggers": ["sentry", "error.*tracking", "monitoring.*erreurs", "crash.*report"] },
    { "module": "url_launcher", "ref": "url-launcher", "capability": "deep-linking", "triggers": ["ouvrir.*lien", "url.*externe", "tel:", "mailto"] },
    { "module": "webview_flutter", "ref": "webview-flutter", "capability": "webview", "triggers": ["webview", "embed.*page.*web"] },
    { "module": "connectivity_plus", "ref": "connectivity-plus", "capability": "connectivity", "triggers": ["offline", "hors.*ligne", "connectivite", "reseau.*disponible"] },
    { "module": "package_info_plus", "ref": "package-info-plus", "capability": "app-metadata", "triggers": ["version.*application", "build.*number", "a.*propos"] },
    { "module": "device_info_plus", "ref": "device-info-plus", "capability": "app-metadata", "triggers": ["modele.*appareil", "device.*info", "os.*version"] },
    { "module": "flutter_stripe", "ref": "flutter-stripe", "capability": "stripe", "triggers": ["stripe", "paiement", "payment"] },
    { "module": "fl_chart", "ref": "fl-chart", "capability": "charts", "triggers": ["chart", "graphique", "courbe", "visualisation.*donnees"] },
    { "module": "talker_flutter", "ref": "talker", "capability": "in-app-logs", "triggers": ["log.*ecran", "console.*in-app", "talker"], "rationale": "Visualiseur de logs / erreurs embarque dans l'app (ecran debug)", "alternative": true },
    { "module": "get_it", "ref": "get-it", "capability": "service-locator", "triggers": ["service.*locator", "get_it", "injection.*manuelle"], "rationale": "Uniquement si l'US impose un service locator hors Riverpod — Riverpod couvre deja la DI", "alternative": true },
    { "module": "flutter_bloc", "ref": "flutter-bloc", "capability": "state-management-alt", "triggers": ["\\bbloc\\b", "cubit", "flutter_bloc"], "rationale": "Alternative a Riverpod. Mutuellement exclusif : ne JAMAIS livrer les deux dans le meme projet", "alternative": true },
    { "module": "bloc", "ref": "bloc", "capability": "state-management-alt", "triggers": ["\\bbloc\\b", "cubit"], "alternative": true },
    { "module": "equatable", "ref": "equatable", "capability": "state-management-alt", "triggers": ["\\bbloc\\b", "equatable"], "rationale": "Egalite par valeur — convention BLoC (freezed le fait deja cote Riverpod)", "alternative": true },
    { "module": "patrol", "ref": "patrol", "capability": "e2e-tests", "triggers": ["tests.*e2e", "test.*integration.*natif", "patrol"], "rationale": "Tests E2E pilotant les dialogues natifs (permissions, notifications) — hors de portee d'integration_test seul" },
    { "module": "very_good_analysis", "ref": "very-good-analysis", "capability": "strict-lints", "triggers": ["lint.*strict", "analyse.*statique.*stricte", "very_good"], "rationale": "Jeu de lints plus severe que flutter_lints. Mutuellement exclusif avec lui dans analysis_options.yaml", "alternative": true }
  ]
}
