    "flash-list": "2.0.2",
    "mmkv": "4.3.2",
    "nitro-modules": "0.37.1",
    "nitro-image": "0.15.2",
    "expo-sqlite": "57.0.2",
    "expo-camera": "57.0.4",
    "vision-camera": "5.2.3",
    "expo-image-picker": "57.0.15",
    "expo-location": "57.0.15",
    "react-native-maps": "1.27.2",
    "expo-maps": "57.0.2",
    "mapbox-maps": "10.3.5",
