{
  "$schema": "../../templates/libs-catalog.schema.json",
  "stackId": "react-native",
  "category": "mobiles",
  "schemaVersion": 1,
  "buildSystem": "npm",
  "manifest": {
    "files": [
      "workspace/src/{AppName}/package.json",
      "workspace/src/{AppName}/app.json",
      "workspace/src/{AppName}/tsconfig.json",
      "workspace/src/{AppName}/babel.config.js",
      "workspace/src/{AppName}/metro.config.js",
      "workspace/src/{AppName}/tailwind.config.js",
      "workspace/src/{AppName}/global.css"
    ]
  },
  "metadata": {
    "lastUpdated": "2026-09-02",
    "platforms": ["ios", "android"],
    "optionalPlatforms": ["web"],
    "workflow": "expo-managed",
    "newArchitecture": true,
    "expoSdk": "57",
    "versionSourceOfTruth": "expo@57.0.19/bundledNativeModules.json",
    "notes": "Mobile stack consomme un backend separe declare dans ## Active Tech Specs. category=mobiles (depuis schema v1 etendu 2026-05-16). REGLE DE PIN (audit 2026-09-02) : toute lib presente dans bundledNativeModules.json de l'Expo SDK cible est pinnee sur CETTE valeur, jamais sur npm latest — c'est ce que resout `npx expo install`, et un ecart fait echouer `expo-doctor`. Exemple concret : react-native-gesture-handler est en 3.2.1 sur npm mais l'SDK 57 exige ~2.32.0. Les libs pure-JS absentes du bundle (zustand, zod, tanstack-query, nativewind) sont pinnees sur npm latest stable."
  },
  "versions": {
    "expo": "57.0.19",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-dom": "19.2.3",
    "react-native-web": "0.21.2",
    "typescript": "6.0.3",
    "react-types": "19.2.2",
    "expo-router": "57.0.18",
    "expo-status-bar": "57.0.1",
    "expo-constants": "57.0.17",
    "expo-linking": "57.0.9",
    "expo-splash-screen": "57.0.8",
    "expo-font": "57.0.3",
    "expo-image": "57.0.4",
    "expo-localization": "57.0.1",
    "expo-secure-store": "57.0.3",
    "expo-system-ui": "57.0.3",
    "react-native-screens": "4.26.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "nativewind": "4.2.6",
    "tailwindcss": "3.4.19",
    "zustand": "5.0.15",
    "tanstack-query": "5.102.8",
    "react-hook-form": "7.87.0",
    "hookform-resolvers": "5.9.1",
    "zod": "4.5.4",
