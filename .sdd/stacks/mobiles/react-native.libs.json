    "jotai": "2.20.3",
    "expo-video": "57.0.3",
    "expo-audio": "57.0.4",
    "expo-file-system": "57.0.6",
    "expo-updates": "57.0.20",
    "expo-dev-client": "57.0.17",
    "expo-build-properties": "57.0.16",
    "netinfo": "12.0.1",
    "jest": "30.5.1",
    "jest-expo": "57.0.5",
    "testing-library-rn": "14.0.1",
    "test-renderer": "1.2.0"
  },
  "core": [
    { "module": "expo", "ref": "expo", "rationale": "SDK Expo 57 (Metro, modules natifs, EAS Build)" },
    { "module": "react", "ref": "react", "rationale": "Version imposee par l'SDK 57 (bundledNativeModules)" },
    { "module": "react-native", "ref": "react-native", "rationale": "Version imposee par l'SDK 57 — PAS npm latest (0.87.x casse l'SDK 57)" },
    { "module": "react-dom", "ref": "react-dom", "rationale": "Necessaire pour Expo Web optionnel" },
    { "module": "react-native-web", "ref": "react-native-web", "rationale": "Cible Web optionnelle — c'est la cible du bench 2026-06-05" },
    { "module": "typescript", "ref": "typescript", "rationale": "Version du template expo-template-default@57 — TS 7.x pas encore valide par Expo" },
    { "module": "@types/react", "ref": "react-types" },
    { "module": "expo-router", "ref": "expo-router", "rationale": "File-based routing — defaut Expo SDK 51+" },
    { "module": "expo-status-bar", "ref": "expo-status-bar" },
    { "module": "expo-constants", "ref": "expo-constants", "rationale": "Lecture de app.json.expo.extra (apiBaseUrl, apiVersion)" },
    { "module": "expo-linking", "ref": "expo-linking", "rationale": "Deep linking + Universal Links" },
    { "module": "expo-splash-screen", "ref": "expo-splash-screen" },
    { "module": "expo-font", "ref": "expo-font" },
    { "module": "expo-image", "ref": "expo-image", "rationale": "Cache + transformations (remplace RN Image)" },
    { "module": "expo-localization", "ref": "expo-localization" },
    { "module": "expo-secure-store", "ref": "expo-secure-store", "rationale": "Tokens JWT, secrets (Keychain iOS / Keystore Android)" },
    { "module": "expo-system-ui", "ref": "expo-system-ui", "rationale": "Couleur de fond racine + barre navigation Android (template SDK 57)" },
    { "module": "react-native-screens", "ref": "react-native-screens", "rationale": "Peer Expo Router (native screens)" },
    { "module": "react-native-safe-area-context", "ref": "react-native-safe-area-context", "rationale": "Peer Expo Router (notch / status bar insets)" },
    { "module": "react-native-gesture-handler", "ref": "react-native-gesture-handler", "rationale": "Peer Expo Router — pin SDK 57 (~2.32), npm latest 3.x incompatible" },
    { "module": "react-native-reanimated", "ref": "react-native-reanimated", "rationale": "Animations natives 60fps. v4 externalise les Worklets (cf. lib suivante)" },
    { "module": "react-native-worklets", "ref": "react-native-worklets", "rationale": "PEER OBLIGATOIRE de reanimated 4.x — absent du catalog avant l'audit 2026-09-02, le bundling echouait" },
    { "module": "nativewind", "ref": "nativewind", "rationale": "Tailwind compile vers StyleSheet RN — top-1 styling" },
    { "module": "tailwindcss", "ref": "tailwindcss", "rationale": "Peer NativeWind 4 — ligne v3 (tag npm v3-lts) OBLIGATOIRE. Tailwind v4 exige NativeWind 5, encore en preview" },
    { "module": "zustand", "ref": "zustand", "rationale": "State manager client — top-1 simple, succede Redux/Context" },
    { "module": "@tanstack/react-query", "ref": "tanstack-query", "rationale": "Server state cache — standard de facto" },
    { "module": "react-hook-form", "ref": "react-hook-form", "rationale": "Forms — meme stack que frontend/react.md" },
    { "module": "@hookform/resolvers", "ref": "hookform-resolvers", "rationale": "v5 requis pour supporter Zod v4" },
    { "module": "zod", "ref": "zod", "rationale": "Validation forms + parsing API responses (v4)" },
    { "module": "@react-native-async-storage/async-storage", "ref": "async-storage", "rationale": "KV storage non sensible — standard RN" },
    { "module": "eslint", "ref": "eslint" },
    { "module": "eslint-config-expo", "ref": "eslint-config-expo" }
  ],
  "onDemand": [
    { "module": "axios", "ref": "axios", "capability": "http-client", "triggers": ["\\baxios\\b", "http-client", "appel.*api.*externe"] },
    { "module": "date-fns", "ref": "date-fns", "capability": "date-utils", "triggers": ["dates.*format", "duree", "intervalle.*temps"] },
    { "module": "dayjs", "ref": "dayjs", "capability": "date-utils", "triggers": ["dayjs", "dates.*format"], "alternative": true },
    { "module": "@expo/vector-icons", "ref": "expo-vector-icons", "capability": "icons", "triggers": ["icones", "icon-set", "vector-icons", "ionicons", "material-icons"], "rationale": "Defaut — livre avec Expo, aucun linking natif" },
    { "module": "lucide-react-native", "ref": "lucide-rn", "capability": "icons", "triggers": ["lucide"], "rationale": "Requiert react-native-svg (capability svg) en co-install", "alternative": true },
    { "module": "@expo/ui", "ref": "expo-ui", "capability": "native-ui", "triggers": ["composants.*natifs", "swiftui", "jetpack.*compose", "look.*natif"], "rationale": "Primitives SwiftUI / Jetpack Compose exposees a RN (nouveau SDK 57)" },
    { "module": "react-native-keyboard-controller", "ref": "keyboard-controller", "capability": "forms-ui", "triggers": ["keyboard.*controller", "forms.*native"] },
    { "module": "@shopify/flash-list", "ref": "flash-list", "capability": "flashlist", "triggers": ["grandes.*listes", "performance.*list", "virtualization"] },
    { "module": "react-native-nitro-modules", "ref": "nitro-modules", "capability": "nitro", "triggers": ["nitro", "mmkv", "vision-camera"], "rationale": "PEER OBLIGATOIRE de react-native-mmkv 4.x et vision-camera 5.x" },
    { "module": "react-native-mmkv", "ref": "mmkv", "capability": "mmkv", "triggers": ["mmkv", "kv.*rapide", "performance.*storage"], "rationale": "Co-installer la capability nitro" },
    { "module": "expo-sqlite", "ref": "expo-sqlite", "capability": "offline-db", "triggers": ["sqlite", "offline-first", "local.*db", "persistance.*locale"] },
    { "module": "expo-camera", "ref": "expo-camera", "capability": "camera", "triggers": ["camera", "photo", "scan.*qr", "scan.*barcode", "code-barre"], "rationale": "Inclut le scan de codes-barres (CameraView.onBarcodeScanned) — remplace expo-barcode-scanner, retire depuis l'SDK 51" },
    { "module": "react-native-vision-camera", "ref": "vision-camera", "capability": "camera", "triggers": ["vision-camera", "photo.*haute.*qualite", "frame.*processor"], "rationale": "Co-installer nitro + react-native-nitro-image", "alternative": true },
    { "module": "react-native-nitro-image", "ref": "nitro-image", "capability": "nitro", "triggers": ["vision-camera"], "rationale": "PEER OBLIGATOIRE de vision-camera 5.x", "alternative": true },
    { "module": "expo-image-picker", "ref": "expo-image-picker", "capability": "image-picker", "triggers": ["gallerie", "image-picker", "choisir.*photo"] },
    { "module": "expo-location", "ref": "expo-location", "capability": "location", "triggers": ["gps", "location", "geolocalisation"] },
    { "module": "expo-maps", "ref": "expo-maps", "capability": "maps", "triggers": ["maps", "carte", "marker"], "rationale": "Module Expo officiel (Google Maps SDK / Apple MapKit) — defaut SDK 57" },
    { "module": "react-native-maps", "ref": "react-native-maps", "capability": "maps", "triggers": ["react-native-maps", "google.*maps"], "alternative": true },
    { "module": "@rnmapbox/maps", "ref": "mapbox-maps", "capability": "maps", "triggers": ["mapbox", "carte.*custom"], "alternative": true },
    { "module": "expo-notifications", "ref": "expo-notifications", "capability": "push", "triggers": ["push.*notification", "notification.*push"] },
    { "module": "expo-auth-session", "ref": "expo-auth-session", "capability": "auth-local", "triggers": ["oauth", "auth-local", "oidc", "pkce"] },
    { "module": "expo-web-browser", "ref": "expo-web-browser", "capability": "auth-local", "triggers": ["oauth", "oidc", "auth.*navigateur"], "rationale": "Peer expo-auth-session (ASWebAuthenticationSession / Custom Tabs)" },
    { "module": "react-native-msal", "ref": "react-native-msal", "capability": "auth-azure-ad", "triggers": ["azure-ad", "msal", "entra", "sso"], "rationale": "Wrapper MSAL iOS/Android. Remplace @azure/msal-react-native qui N EXISTE PAS sur npm (phantom corrige audit 2026-09-02)" },
    { "module": "expo-local-authentication", "ref": "expo-local-auth", "capability": "biometric", "triggers": ["biometric", "face-id", "touch-id", "fingerprint"] },
    { "module": "@sentry/react-native", "ref": "sentry-rn", "capability": "sentry", "triggers": ["sentry", "error.*tracking", "monitoring.*erreurs"], "rationale": "Pin SDK 57 (~7.11) — npm latest 8.x pas encore aligne Expo" },
    { "module": "i18next", "ref": "i18next", "capability": "i18n", "triggers": ["i18n", "multi.*langue", "traductions"] },
    { "module": "react-i18next", "ref": "react-i18next", "capability": "i18n", "triggers": ["i18n", "react-i18next"] },
    { "module": "@stripe/stripe-react-native", "ref": "stripe-rn", "capability": "stripe", "triggers": ["stripe", "paiement", "payment"], "rationale": "Pin SDK 57 (0.64.0)" },
    { "module": "react-native-webview", "ref": "webview", "capability": "webview", "triggers": ["webview", "embed.*page.*web"] },
    { "module": "react-native-svg", "ref": "rn-svg", "capability": "svg", "triggers": ["svg", "vector.*graphics", "lucide"] },
    { "module": "expo-video", "ref": "expo-video", "capability": "media-playback", "triggers": ["video", "lecteur.*video", "player"], "rationale": "Remplace expo-av (deprecie, retire du bundle SDK 57)" },
    { "module": "expo-audio", "ref": "expo-audio", "capability": "media-playback", "triggers": ["audio", "son", "enregistrement.*audio"], "rationale": "Remplace expo-av (deprecie)" },
    { "module": "expo-file-system", "ref": "expo-file-system", "capability": "filesystem", "triggers": ["fichier.*local", "download", "telechargement", "cache.*disque"] },
    { "module": "@react-native-community/netinfo", "ref": "netinfo", "capability": "connectivity", "triggers": ["offline", "hors.*ligne", "connectivite", "reseau.*disponible"] },
    { "module": "expo-updates", "ref": "expo-updates", "capability": "ota-updates", "triggers": ["ota", "eas.*update", "mise.*a.*jour.*a.*chaud"] },
    { "module": "expo-dev-client", "ref": "expo-dev-client", "capability": "dev-client", "triggers": ["dev-client", "module.*natif.*custom", "prebuild"] },
    { "module": "expo-build-properties", "ref": "expo-build-properties", "capability": "dev-client", "triggers": ["build.*properties", "minsdk", "deployment.*target"] },
    { "module": "jest", "ref": "jest", "capability": "rn-testing", "triggers": ["tests.*unitaires.*mobile", "jest"] },
    { "module": "jest-expo", "ref": "jest-expo", "capability": "rn-testing", "triggers": ["tests.*unitaires.*mobile", "jest"] },
    { "module": "@testing-library/react-native", "ref": "testing-library-rn", "capability": "rn-testing", "triggers": ["tests.*composants", "testing-library", "render.*screen"] },
    { "module": "test-renderer", "ref": "test-renderer", "capability": "rn-testing", "triggers": ["testing-library"], "rationale": "PEER OBLIGATOIRE de @testing-library/react-native 14.x" },
    { "module": "jotai", "ref": "jotai", "capability": "reactive-state", "triggers": ["jotai", "atomic.*state"], "alternative": true }
  ]
}
