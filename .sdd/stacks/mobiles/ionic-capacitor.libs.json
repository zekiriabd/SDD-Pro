{
  "$schema": "../../templates/libs-catalog.schema.json",
  "stackId": "ionic-capacitor",
  "category": "mobiles",
  "schemaVersion": 1,
  "buildSystem": "npm",
  "manifest": {
    "files": [
      "workspace/src/{AppName}/package.json",
      "workspace/src/{AppName}/capacitor.config.ts",
      "workspace/src/{AppName}/ionic.config.json",
      "workspace/src/{AppName}/angular.json",
      "workspace/src/{AppName}/tsconfig.json",
      "workspace/src/{AppName}/android/app/src/main/AndroidManifest.xml",
      "workspace/src/{AppName}/ios/App/App/Info.plist"
    ]
  },
  "metadata": {
    "lastUpdated": "2026-09-02",
    "platforms": ["android", "ios"],
    "optionalPlatforms": ["web-pwa", "electron"],
    "workflow": "hybrid-webview",
    "uiFramework": "angular",
    "toolchain": {
      "ionic": "9.0.1",
      "capacitor": "8.5.1",
      "angular": "22.1.4",
      "typescript": "6.0.3",
      "node": ">=22"
    },
    "notes": "Stack mobile HYBRIDE : l'application est une SPA web executee dans une WebView systeme (WKWebView iOS / Android WebView), Capacitor exposant les APIs natives via des plugins. Consomme un backend separe declare en ## Active Tech Specs. Binding UI par defaut = Angular (le couple historique et le mieux couvert par la CLI Ionic) ; React et Vue sont supportes en amont mais hors catalog. CONTRAINTE TYPESCRIPT : @ionic/angular-toolkit 13.0.0 declare `typescript: >=5.9.0 <6.1.0` — TypeScript 7.x est donc INTERDIT sur ce stack malgre sa disponibilite npm. Pin sur 6.0.3. Contrainte Angular : @ionic/angular 9 exige @angular/core >=18, @ngrx/signals 22 exige ^22 — le couple retenu est Angular 22.1.4. IMPORTANT CORS : les origines WebView sont `capacitor://localhost` (iOS) et `http://localhost` (Android) — elles DOIVENT figurer dans l'allowlist CORS du backend, cf. rules/library-and-stack.md Partie B.1."
  },
  "versions": {
    "ionic-angular": "9.0.1",
    "ionic-core": "9.0.1",
    "ionicons": "8.1.0",
    "ionic-cli": "7.2.1",
    "ionic-angular-toolkit": "13.0.0",
    "capacitor": "8.5.1",
    "capacitor-app": "8.1.1",
    "capacitor-haptics": "8.0.2",
    "capacitor-keyboard": "8.0.5",
    "capacitor-status-bar": "8.0.3",
    "capacitor-splash-screen": "8.0.2",
    "capacitor-preferences": "8.0.1",
    "capacitor-network": "8.0.1",
    "capacitor-device": "8.0.3",
    "capacitor-filesystem": "8.1.3",
    "capacitor-camera": "8.2.4",
    "capacitor-geolocation": "8.2.2",
    "capacitor-push-notifications": "8.1.2",
    "capacitor-local-notifications": "8.3.1",
    "capacitor-share": "8.0.1",
    "capacitor-browser": "8.0.4",
    "capacitor-clipboard": "8.0.1",
    "capacitor-action-sheet": "8.1.1",
    "capacitor-dialog": "8.0.1",
    "capacitor-toast": "8.0.1",
    "capacitor-screen-reader": "8.0.1",
    "capacitor-google-maps": "8.0.1",
    "capacitor-assets": "3.0.5",
    "capacitor-sqlite": "8.1.1",
    "capacitor-mlkit-barcode": "8.1.1",
    "capacitor-biometric": "4.2.2",
    "angular": "22.1.4",
    "angular-cli": "22.1.6",
    "rxjs": "7.8.2",
    "zone-js": "0.16.2",
    "typescript": "6.0.3",
    "ngrx-signals": "22.0.0",
    "jasmine-core": "7.0.2",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-jasmine": "5.1.0",
    "karma-coverage": "2.2.1",
    "types-jasmine": "6.0.0"
  },
  "core": [
    { "module": "@ionic/angular", "ref": "ionic-angular", "rationale": "Composants UI Ionic pour Angular (ion-*) — look adaptatif iOS/Material" },
    { "module": "@ionic/core", "ref": "ionic-core", "rationale": "Web components sous-jacents (Stencil) — peer de @ionic/angular" },
    { "module": "ionicons", "ref": "ionicons", "rationale": "Jeu d'icones officiel Ionic" },
    { "module": "@capacitor/core", "ref": "capacitor", "rationale": "Runtime Capacitor — pont JS <-> natif" },
    { "module": "@capacitor/cli", "ref": "capacitor", "rationale": "CLI (sync, copy, open) — devDependency" },
    { "module": "@capacitor/android", "ref": "capacitor", "rationale": "Projet natif Android (wrapper WebView)" },
    { "module": "@capacitor/ios", "ref": "capacitor", "rationale": "Projet natif iOS (wrapper WKWebView)" },
    { "module": "@capacitor/app", "ref": "capacitor-app", "rationale": "Cycle de vie app + bouton retour Android + deep links (appUrlOpen)" },
    { "module": "@capacitor/haptics", "ref": "capacitor-haptics", "rationale": "Retour haptique — attendu par les composants Ionic" },
    { "module": "@capacitor/keyboard", "ref": "capacitor-keyboard", "rationale": "Evenements clavier — sans lui les formulaires sont masques par le clavier iOS" },
    { "module": "@capacitor/status-bar", "ref": "capacitor-status-bar", "rationale": "Style de la barre d'etat (indispensable en mode sombre)" },
    { "module": "@capacitor/splash-screen", "ref": "capacitor-splash-screen", "rationale": "Masque le flash blanc de la WebView au demarrage" },
    { "module": "@capacitor/preferences", "ref": "capacitor-preferences", "rationale": "Cle-valeur NON sensible (NSUserDefaults / SharedPreferences). PAS pour les tokens — cf. capability biometric-secure-storage" },
    { "module": "@angular/core", "ref": "angular" },
    { "module": "@angular/common", "ref": "angular" },
    { "module": "@angular/forms", "ref": "angular", "rationale": "Peer declare par @ionic/angular 9" },
    { "module": "@angular/router", "ref": "angular", "rationale": "Peer declare par @ionic/angular 9 — routing des pages Ionic" },
    { "module": "@angular/platform-browser", "ref": "angular" },
    { "module": "@angular/compiler", "ref": "angular" },
    { "module": "rxjs", "ref": "rxjs", "rationale": "Peer Angular + @ionic/angular (>=7.5.0)" },
    { "module": "zone.js", "ref": "zone-js", "rationale": "Peer Angular (>=0.13.0)" },
    { "module": "typescript", "ref": "typescript", "rationale": "PIN OBLIGATOIRE sur la ligne 6.0 : @ionic/angular-toolkit 13 declare `typescript >=5.9.0 <6.1.0`. TypeScript 7.x est disponible sur npm mais INTERDIT ici" },
    { "module": "@angular/cli", "ref": "angular-cli", "rationale": "devDependency — build et serve" },
    { "module": "@angular/compiler-cli", "ref": "angular", "rationale": "devDependency — compilation AOT" },
    { "module": "@ionic/angular-toolkit", "ref": "ionic-angular-toolkit", "rationale": "devDependency — schematics Ionic (ng generate page)" }
  ],
  "onDemand": [
    { "module": "@capacitor/network", "ref": "capacitor-network", "capability": "connectivity", "triggers": ["offline", "hors.*ligne", "connectivite", "reseau.*disponible"] },
    { "module": "@capacitor/device", "ref": "capacitor-device", "capability": "app-metadata", "triggers": ["modele.*appareil", "device.*info", "os.*version", "uuid.*appareil"] },
    { "module": "@capacitor/filesystem", "ref": "capacitor-filesystem", "capability": "filesystem", "triggers": ["fichier.*local", "telechargement", "export.*fichier", "download"] },
    { "module": "@capacitor/camera", "ref": "capacitor-camera", "capability": "camera", "triggers": ["camera", "photo", "gallerie", "image-picker"] },
    { "module": "@capacitor/geolocation", "ref": "capacitor-geolocation", "capability": "location", "triggers": ["gps", "geolocalisation", "position.*utilisateur"] },
    { "module": "@capacitor/google-maps", "ref": "capacitor-google-maps", "capability": "maps", "triggers": ["maps", "carte", "marker", "google.*maps"] },
    { "module": "@capacitor/push-notifications", "ref": "capacitor-push-notifications", "capability": "push", "triggers": ["push.*notification", "notification.*distante", "fcm", "apns"] },
    { "module": "@capacitor/local-notifications", "ref": "capacitor-local-notifications", "capability": "local-notification", "triggers": ["notification.*locale", "rappel", "reminder", "notification.*planifiee"] },
    { "module": "@capacitor/share", "ref": "capacitor-share", "capability": "share", "triggers": ["partager", "share.*sheet", "partage.*natif"] },
    { "module": "@capacitor/browser", "ref": "capacitor-browser", "capability": "auth-local", "triggers": ["oauth", "oidc", "auth.*navigateur", "in-app.*browser"], "rationale": "Onglet systeme (SFSafariViewController / Custom Tabs) — OBLIGATOIRE pour un flow OAuth : un OAuth dans la WebView de l'app est refuse par Google et non conforme RFC 8252" },
    { "module": "@capacitor/clipboard", "ref": "capacitor-clipboard", "capability": "clipboard", "triggers": ["presse-papier", "clipboard", "copier.*coller"] },
    { "module": "@capacitor/action-sheet", "ref": "capacitor-action-sheet", "capability": "native-dialogs", "triggers": ["action.*sheet", "menu.*natif"] },
    { "module": "@capacitor/dialog", "ref": "capacitor-dialog", "capability": "native-dialogs", "triggers": ["dialogue.*natif", "alert.*natif", "confirm.*natif"] },
    { "module": "@capacitor/toast", "ref": "capacitor-toast", "capability": "native-dialogs", "triggers": ["toast", "message.*bref"] },
    { "module": "@capacitor/screen-reader", "ref": "capacitor-screen-reader", "capability": "a11y", "triggers": ["accessibilite", "lecteur.*ecran", "voiceover", "talkback"] },
    { "module": "@capacitor-community/sqlite", "ref": "capacitor-sqlite", "capability": "offline-db", "triggers": ["sqlite", "offline-first", "base.*locale", "persistance.*locale"], "rationale": "SQLite natif avec chiffrement optionnel — le stockage web (IndexedDB) n'est pas garanti persistant en WebView" },
    { "module": "@capacitor-mlkit/barcode-scanning", "ref": "capacitor-mlkit-barcode", "capability": "barcode", "triggers": ["scan.*qr", "scan.*barcode", "code-barre"], "rationale": "ML Kit natif — nettement plus fiable qu'un scan JS dans la WebView" },
    { "module": "capacitor-native-biometric", "ref": "capacitor-biometric", "capability": "biometric-secure-storage", "triggers": ["biometric", "face-id", "touch-id", "empreinte", "token.*securise"], "rationale": "Biometrie ET stockage adosse au Keychain/Keystore. C'est le SEUL emplacement acceptable pour un token sur ce stack (cf. .md 1.4)" },
    { "module": "@ngrx/signals", "ref": "ngrx-signals", "capability": "state-management", "triggers": ["state.*global", "store", "signal.*store", "ngrx"], "rationale": "Store a base de Signals — retenu plutot que le NgRx Store classique (Redux), plus verbeux" },
    { "module": "@capacitor/assets", "ref": "capacitor-assets", "capability": "app-icons", "triggers": ["icone.*application", "splash.*screen", "app.*icon"], "rationale": "devDependency — genere toutes les tailles d'icones et de splash depuis une source unique" },
    { "module": "jasmine-core", "ref": "jasmine-core", "capability": "ionic-unit-tests", "triggers": ["tests.*unitaires", "jasmine", "karma"], "rationale": "Runner de tests par defaut d'un projet Angular/Ionic — cf. qa/angular-jasmine.md" },
    { "module": "karma", "ref": "karma", "capability": "ionic-unit-tests", "triggers": ["tests.*unitaires", "jasmine", "karma"] },
    { "module": "karma-jasmine", "ref": "karma-jasmine", "capability": "ionic-unit-tests", "triggers": ["tests.*unitaires", "karma"] },
    { "module": "karma-chrome-launcher", "ref": "karma-chrome-launcher", "capability": "ionic-unit-tests", "triggers": ["tests.*unitaires", "karma"] },
    { "module": "karma-coverage", "ref": "karma-coverage", "capability": "ionic-unit-tests", "triggers": ["coverage", "couverture.*tests"] },
    { "module": "@types/jasmine", "ref": "types-jasmine", "capability": "ionic-unit-tests", "triggers": ["tests.*unitaires", "jasmine"] }
  ]
}
