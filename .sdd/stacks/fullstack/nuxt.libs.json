{
  "$schema": "../../templates/libs-catalog.schema.json",
  "stackId": "nuxt",
  "category": "fullstack",
  "schemaVersion": 1,
  "buildSystem": "npm",
  "manifest": {
    "files": [
      "workspace/src/{AppName}/package.json",
      "workspace/src/{AppName}/nuxt.config.ts",
      "workspace/src/{AppName}/tsconfig.json"
    ]
  },
  "metadata": {
    "platforms": [
      "node-22"
    ],
    "framework": "Nuxt 3 + Nitro engine + Vue 3.5",
    "workflow": "single-project-ssr-universal",
    "notes": "Auto-import (components, composables, server/utils). Deployable serverless via Nitro presets (Vercel, Netlify, Cloudflare).",
    "lastUpdated": "2026-09-02",
    "changeLog": [
      "2026-09-02 — Audit fullstack. Rebase npm complet (Nuxt 3.15.0 -> 4.5.2). PRERELEASE CORRIGEE : `nuxt-ui` etait pinne en 3.0.0-alpha.10 — la ligne 4 est desormais STABLE (4.11.0). C'etait le second WARN PRERELEASE de validate_libs_catalog.py ; les deux sont fermes. ATTENTION `vuetify-nuxt-module` : son dist-tag npm `latest` pointe sur 1.0.0-rc.5, une PRERELEASE. La derniere STABLE est la 0.19.5 — c'est elle qui est pinnee. Ne pas « bumper vers latest » sur ce paquet sans verifier le tag. TypeScript pinne 6.0.3 et non 7.0.2.",
      "2026-09-02 (rectificatif du meme audit) — CORRECTION DE COHERENCE. Le premier passage avait monte ce stack d'une MAJEURE. C'est incoherent avec la politique appliquee aux autres stacks 🟢 du meme audit (backend/kotlin-spring-boot reste en 3.5.x face a Spring Boot 4.1.1, backend/node-express reste en 4.x face a Express 5.2.1) : une majeure invalide la validation runtime qui porte le badge, et aucun bench ne peut etre re-joue ici. Le stack est donc ramene sur le DERNIER PATCH de sa majeure en place. La montee de majeure reste disponible en tache dediee, avec re-bench. Nuxt reste sur la ligne 3 (3.21.11). L'en-tete `Validation:` de ce stack documente explicitement ce pin : « le pin canonique .libs.json reste sur Nuxt 3 LTS — la branche 4 en preview au moment du bench, exclue de CORE par policy runtime LTS only ». La branche 4 est desormais stable (4.5.2), ce qui leve la raison d'origine — mais la montee reste une tache dediee avec re-bench, pas un bump de catalog. Vuetify suit (3.13.3, ligne 3) pour rester aligne avec ui/vuetify.md. nuxt-ui reste corrige en 4.11.0 : c'etait une PRERELEASE (3.0.0-alpha.10), sa correction n'est pas un choix de majeure mais l'application de rules/library-and-stack.md 5."
    ]
  },
  "versions": {
    "nuxt": "3.21.11",
    "vue": "3.5.42",
    "vuetify": "3.13.3",
    "vuetify-nuxt-module": "0.19.5",
    "typescript": "5.9.3",
    "zod": "4.5.4",
    "vee-validate": "4.15.1",
    "veevalidate-zod": "4.15.1",
    "pinia": "2.3.1",
    "pinia-nuxt": "0.11.3",
    "nuxt-auth": "0.10.0",
    "nuxt-i18n": "9.5.6",
    "nuxt-eslint": "0.7.6",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "prisma-client": "7.10.0",
    "nuxt-tailwind": "6.14.0",
    "nuxt-ui": "4.11.0",
    "msal-node": "3.8.10",
    "ofetch": "1.5.1",
    "exceljs": "4.4.0",
    "pdfkit": "0.20.2",
    "nodemailer": "6.10.1",
    "vueuse": "12.8.2",
    "nuxt-security": "2.6.0",
    "nuxt-gtag": "3.0.3"
  },
  "core": [
    {
      "module": "nuxt",
      "ref": "nuxt",
      "rationale": "Framework SSR + Nitro"
    },
    {
      "module": "vue",
      "ref": "vue"
    },
    {
      "module": "vuetify",
      "ref": "vuetify",
      "rationale": "Design System defaut"
    },
    {
      "module": "vuetify-nuxt-module",
      "ref": "vuetify-nuxt-module",
      "rationale": "Integration Nuxt + Vuetify SSR-ready"
    },
    {
      "module": "typescript",
      "ref": "typescript"
    },
    {
      "module": "zod",
      "ref": "zod",
      "rationale": "Validation schemas"
    },
    {
      "module": "vee-validate",
      "ref": "vee-validate",
      "rationale": "Forms validation Vue-idiomatic"
    },
    {
      "module": "@vee-validate/zod",
      "ref": "veevalidate-zod"
    },
    {
      "module": "pinia",
      "ref": "pinia",
      "rationale": "State store client"
    },
    {
      "module": "@pinia/nuxt",
      "ref": "pinia-nuxt"
    },
    {
      "module": "@sidebase/nuxt-auth",
      "ref": "nuxt-auth",
      "rationale": "Auth (NextAuth-like pour Nuxt)"
    },
    {
      "module": "@nuxtjs/i18n",
      "ref": "nuxt-i18n"
    },
    {
      "module": "@nuxt/eslint",
      "ref": "nuxt-eslint"
    },
    {
      "module": "pino",
      "ref": "pino"
    },
    {
      "module": "pino-pretty",
      "ref": "pino-pretty"
    }
  ],
  "onDemand": [
    {
      "module": "prisma",
      "ref": "prisma",
      "capability": "prisma",
      "triggers": [
        "DatabaseType.*\\b(SqlServer|PostgreSql|MySql|Sqlite)\\b",
        "orm",
        "db-first"
      ]
    },
    {
      "module": "@prisma/client",
      "ref": "prisma-client",
      "capability": "prisma",
      "triggers": [
        "prisma",
        "orm"
      ]
    },
    {
      "module": "@nuxtjs/tailwindcss",
      "ref": "nuxt-tailwind",
      "capability": "tailwind",
      "triggers": [
        "tailwind",
        "atomic.*css"
      ]
    },
    {
      "module": "@nuxt/ui",
      "ref": "nuxt-ui",
      "capability": "nuxt-ui",
      "triggers": [
        "nuxt-ui",
        "ui-kit-nuxt"
      ],
      "alternative": true
    },
    {
      "module": "@azure/msal-node",
      "ref": "msal-node",
      "capability": "auth-azure-ad",
      "triggers": [
        "auth-azure-ad",
        "msal"
      ]
    },
    {
      "module": "ofetch",
      "ref": "ofetch",
      "capability": "http-client",
      "triggers": [
        "appel.*api.*externe"
      ]
    },
    {
      "module": "exceljs",
      "ref": "exceljs",
      "capability": "excel",
      "triggers": [
        "\\bexcel\\b",
        "\\.xlsx\\b",
        "export.*excel"
      ]
    },
    {
      "module": "pdfkit",
      "ref": "pdfkit",
      "capability": "pdf",
      "triggers": [
        "\\bpdf\\b",
        "export.*pdf"
      ]
    },
    {
      "module": "nodemailer",
      "ref": "nodemailer",
      "capability": "smtp",
      "triggers": [
        "email",
        "smtp"
      ]
    },
    {
      "module": "@vueuse/core",
      "ref": "vueuse",
      "capability": "date-utils",
      "triggers": [
        "date",
        "time",
        "utils.*reactive"
      ]
    },
    {
      "module": "nuxt-security",
      "ref": "nuxt-security",
      "capability": "security-headers",
      "triggers": [
        "csp",
        "security.*headers",
        "helmet"
      ]
    },
    {
      "module": "nuxt-gtag",
      "ref": "nuxt-gtag",
      "capability": "analytics",
      "triggers": [
        "analytics",
        "google.*tag"
      ]
    }
  ]
}
