{
  "$schema": "../../templates/libs-catalog.schema.json",
  "stackId": "blazor-server",
  "category": "fullstack",
  "schemaVersion": 1,
  "buildSystem": "dotnet",
  "manifest": {
    "files": [
      "workspace/src/{AppName}/{AppName}.csproj",
      "workspace/src/{AppName}/Program.cs",
      "workspace/src/{AppName}/appsettings.json"
    ]
  },
  "metadata": {
    "platforms": [
      "net10.0"
    ],
    "framework": "ASP.NET Core Blazor Server (legacy stack — Razor Pages + SignalR Hub + _Host.cshtml)",
    "workflow": "single-project-ssr-signalr",
    "notes": "Monolithe .NET 10. UI rendue serveur, synchronisee via SignalR. Pas de bundler JS. Microsoft.Identity.Web NON pinne (CVE cycle frequent).",
    "lastUpdated": "2026-09-02",
    "changeLog": [
      "2026-09-02 — Audit fullstack. BUG CRITIQUE CORRIGE : le catalog pinnait `ef-core` en 10.0.6 (utilise par Microsoft.EntityFrameworkCore/.SqlServer/.Design/.Tools) ET `npgsql-ef` en 9.0.4. C'est EXACTEMENT la combinaison du post-mortem DemoApp 2026-05-22 : warning NU1608 au restore, puis MissingMethodException au premier acces DbSet quand DatabaseType=postgres. Le correctif avait ete applique a backend/dotnet-minimalapi le 2026-06-07 mais JAMAIS propage ici — la meme faille latente vivait dans blazor-server et aspnet-mvc-razor. Resolution retenue (identique a backend/dotnet-minimalapi) : EF Core 10.0.11 aligne avec Npgsql.EF 10.0.3, desormais STABLE. CONTRAINTE RESIDUELLE : Pomelo.EntityFrameworkCore.MySql n'a aucune version 10.x publiee (derniere stable 9.0.0) -> pour DatabaseType=mysql|mariadb, EF Core doit rester en 9.0.4 (versions.ef-core-mysql-lcd + dbDrivers[].efCoreVersionOverride)."
    ]
  },
  "dbDrivers": {
    "sqlserver": {
      "module": "Microsoft.EntityFrameworkCore.SqlServer",
      "ref": "ef-core"
    },
    "postgres": {
      "module": "Npgsql.EntityFrameworkCore.PostgreSQL",
      "ref": "npgsql-ef"
    },
    "mysql": {
      "module": "Pomelo.EntityFrameworkCore.MySql",
      "ref": "pomelo-ef",
      "efCoreVersionOverride": "9.0.4"
    },
    "sqlite": {
      "module": "Microsoft.EntityFrameworkCore.Sqlite",
      "ref": "ef-core"
    }
  },
  "versions": {
    "ef-core": "10.0.11",
    "automapper": "16.2.0",
    "serilog-aspnetcore": "10.0.0",
    "serilog-console": "6.1.1",
    "msal-web": "4.14.2",
    "msal-web-ui": "4.14.2",
    "npgsql-ef": "10.0.3",
    "pomelo-ef": "9.0.0",
    "closedxml": "0.105.1",
    "questpdf": "2026.8.0",
    "http-polly": "10.0.11",
    "mailkit": "4.17.0",
    "mimekit": "4.17.0",
    "ef-core-mysql-lcd": "9.0.4"
  },
  "core": [
    {
      "module": "Microsoft.EntityFrameworkCore",
      "ref": "ef-core",
      "rationale": "ORM principal"
    },
    {
      "module": "Microsoft.EntityFrameworkCore.SqlServer",
      "ref": "ef-core",
      "rationale": "Provider defaut (override via dbDrivers selon DatabaseType)"
    },
    {
      "module": "Microsoft.EntityFrameworkCore.Design",
      "ref": "ef-core"
    },
    {
      "module": "Microsoft.EntityFrameworkCore.Tools",
      "ref": "ef-core"
    },
    {
      "module": "AutoMapper",
      "ref": "automapper",
      "rationale": "Mapping Entity → Model"
    },
    {
      "module": "Serilog.AspNetCore",
      "ref": "serilog-aspnetcore",
      "rationale": "Logger structure"
    },
    {
      "module": "Serilog.Sinks.Console",
      "ref": "serilog-console"
    },
    {
      "module": "Microsoft.Identity.Web",
      "ref": "msal-web",
      "rationale": "Auth Azure AD — NON PINNE (CVE cycle, dotnet add sans --version)"
    },
    {
      "module": "Microsoft.Identity.Web.UI",
      "ref": "msal-web-ui",
      "rationale": "UI auth Azure AD — NON PINNE"
    }
  ],
  "onDemand": [
    {
      "module": "Npgsql.EntityFrameworkCore.PostgreSQL",
      "ref": "npgsql-ef",
      "capability": "db-postgres",
      "triggers": [
        "DatabaseType.*PostgreSql",
        "postgres"
      ]
    },
    {
      "module": "Pomelo.EntityFrameworkCore.MySql",
      "ref": "pomelo-ef",
      "capability": "db-mysql",
      "triggers": [
        "DatabaseType.*MySql",
        "mysql",
        "mariadb"
      ]
    },
    {
      "module": "Microsoft.EntityFrameworkCore.Sqlite",
      "ref": "ef-core",
      "capability": "db-sqlite",
      "triggers": [
        "DatabaseType.*Sqlite"
      ]
    },
    {
      "module": "ClosedXML",
      "ref": "closedxml",
      "capability": "excel",
      "triggers": [
        "\\bexcel\\b",
        "\\.xlsx\\b",
        "export.*excel"
      ]
    },
    {
      "module": "QuestPDF",
      "ref": "questpdf",
      "capability": "pdf",
      "triggers": [
        "\\bpdf\\b",
        "\\.pdf\\b",
        "export.*pdf",
        "generer.*pdf"
      ]
    },
    {
      "module": "Microsoft.Extensions.Http.Polly",
      "ref": "http-polly",
      "capability": "http-client",
      "triggers": [
        "appel.*api.*externe",
        "service.*externe"
      ]
    },
    {
      "module": "MailKit",
      "ref": "mailkit",
      "capability": "smtp",
      "triggers": [
        "email",
        "smtp",
        "envoi.*mail",
        "notification.*mail"
      ]
    },
    {
      "module": "MimeKit",
      "ref": "mimekit",
      "capability": "smtp",
      "triggers": [
        "email",
        "smtp"
      ]
    }
  ]
}
