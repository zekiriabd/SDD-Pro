{
  "$schema": "../../templates/libs-catalog.schema.json",
  "stackId": "django-templates",
  "category": "fullstack",
  "schemaVersion": 1,
  "buildSystem": "uv",
  "manifest": {
    "files": [
      "workspace/src/{AppName}/pyproject.toml",
      "workspace/src/{AppName}/manage.py",
      "workspace/src/{AppName}/config/settings/base.py",
      "workspace/src/{AppName}/config/urls.py",
      "workspace/src/{AppName}/templates/base.html",
      "workspace/src/{AppName}/.env.example"
    ]
  },
  "metadata": {
    "lastUpdated": "2026-09-02",
    "runtime": "python 3.12",
    "framework": "django 5.2 LTS + django templates",
    "rendering": "SSR",
    "notes": "Monolithe SSR Django : le moteur de templates Django rend le HTML cote serveur, django-htmx apporte l'interactivite sans SPA. UN seul projet {AppName}/. MEME CHOIX DE VERSION que backend/django : Django 5.2 LTS et NON 6.1 — Django publie des LTS explicites (4.2, 5.2, 6.2) et rules/library-and-stack.md 0 impose « runtime LTS only » ; la 6.1 n'est pas une LTS. DIFFERENCE AVEC backend/django : ce stack n'installe NI djangorestframework, NI drf-spectacular, NI simplejwt — il ne sert pas de JSON. Il ajoute en revanche le rendu de formulaires (crispy-forms), htmx et whitenoise. Declarer l'un OU l'autre, jamais les deux. PAS DE PIPELINE NODE : htmx et Alpine sont servis en fichiers statiques ; le stack ne requiert aucun build JS (cf. capability tailwind-build pour le cas contraire)."
  },
  "versions": {
    "python": "3.12",
    "django": "5.2.17",
    "django-environ": "0.14.0",
    "psycopg": "3.3.5",
    "gunicorn": "26.2.0",
    "whitenoise": "6.12.0",
    "crispy-forms": "2.7",
    "crispy-tailwind": "1.0.3",
    "crispy-bootstrap5": "2026.3",
    "django-htmx": "1.29.0",
    "widget-tweaks": "1.5.1",
    "template-partials": "25.3",
    "django-tailwind": "4.5.0",
    "django-compressor": "4.6.0",
    "structlog": "26.1.0",
    "django-structlog": "10.1.0",
    "pillow": "12.3.0",
    "django-storages": "1.14.6",
    "celery": "5.6.3",
    "redis": "8.1.0",
    "django-redis": "7.0.0",
    "django-allauth": "65.19.2",
    "django-anymail": "15.1",
    "django-health-check": "4.5.1",
    "sentry-sdk": "2.68.1",
    "django-debug-toolbar": "8.0.0",
    "django-extensions": "4.1",
    "openpyxl": "3.1.5",
    "reportlab": "5.0.1",
    "ruff": "0.16.5",
    "mypy": "2.3.1",
    "django-stubs": "6.1.0",
    "pytest": "9.1.1",
    "pytest-django": "4.14.0",
    "pytest-cov": "7.1.0",
    "model-bakery": "1.24.0"
  },
  "dbDrivers": {
    "postgres": { "module": "psycopg", "ref": "psycopg", "scope": "runtime" },
    "postgresql": { "module": "psycopg", "ref": "psycopg", "scope": "runtime" },
    "sqlite": { "module": "django", "ref": "django", "scope": "runtime" }
  },
  "core": [
    { "module": "django", "ref": "django", "rationale": "Framework — ligne LTS 5.2. Le moteur de templates, le systeme de formulaires et l'admin sont integres" },
    { "module": "django-environ", "ref": "django-environ", "rationale": "Configuration typee lue dans l'environnement" },
    { "module": "psycopg", "ref": "psycopg", "rationale": "Driver PostgreSQL v3" },
    { "module": "django-crispy-forms", "ref": "crispy-forms", "rationale": "Rendu des formulaires Django en HTML structure. Sans lui, `{{ form }}` produit un balisage brut inutilisable en production" },
    { "module": "crispy-tailwind", "ref": "crispy-tailwind", "rationale": "Template pack Tailwind pour crispy-forms. OBLIGATOIRE avec crispy-forms : le paquet de base ne fournit AUCUN pack, `CRISPY_TEMPLATE_PACK` doit pointer sur un pack installe" },
    { "module": "django-htmx", "ref": "django-htmx", "rationale": "Middleware + helpers pour htmx : detecte `request.htmx`, gere les reponses partielles. C'est l'interactivite de ce stack, sans SPA" },
    { "module": "django-template-partials", "ref": "template-partials", "rationale": "Fragments nommes DANS un template — c'est ce qui rend htmx exploitable sans multiplier les fichiers de partiels" },
    { "module": "whitenoise", "ref": "whitenoise", "rationale": "Service des fichiers statiques par l'app (htmx, Alpine, CSS) sans reverse proxy" },
    { "module": "gunicorn", "ref": "gunicorn", "rationale": "Serveur WSGI de production" },
    { "module": "structlog", "ref": "structlog", "rationale": "Logs structures" },
    { "module": "django-structlog", "ref": "django-structlog", "rationale": "Integration Django (request_id correle)" },
    { "module": "ruff", "ref": "ruff", "rationale": "Lint + format (dev)" },
    { "module": "mypy", "ref": "mypy", "rationale": "Typage statique (dev)" },
    { "module": "django-stubs", "ref": "django-stubs", "rationale": "Stubs Django pour mypy (dev)" },
    { "module": "pytest", "ref": "pytest", "rationale": "Runner de tests (dev) — cf. qa/python-pytest.md" },
    { "module": "pytest-django", "ref": "pytest-django", "rationale": "Fixtures Django pour pytest (dev) — sans lui tout import de modele leve ImproperlyConfigured" }
  ],
  "onDemand": [
    { "module": "django-widget-tweaks", "ref": "widget-tweaks", "capability": "form-tweaks", "triggers": ["classe.*css.*champ", "widget", "personnaliser.*formulaire"], "rationale": "Ajout de classes CSS sur un champ depuis le template, sans redefinir le widget en Python", "alternative": true },
    { "module": "crispy-bootstrap5", "ref": "crispy-bootstrap5", "capability": "bootstrap-forms", "triggers": ["bootstrap"], "rationale": "Template pack Bootstrap 5 — EXCLUSIF de crispy-tailwind, un seul CRISPY_TEMPLATE_PACK a la fois", "alternative": true },
    { "module": "django-tailwind", "ref": "django-tailwind", "capability": "tailwind-build", "triggers": ["tailwind", "build.*css"], "rationale": "Integre le pipeline Tailwind a Django. ATTENTION : introduit une dependance a Node, que ce stack evite par defaut" },
    { "module": "django-compressor", "ref": "django-compressor", "capability": "asset-pipeline", "triggers": ["minifier.*css", "concatener.*assets", "compressor"] },
    { "module": "pillow", "ref": "pillow", "capability": "image-processing", "triggers": ["image", "upload.*photo", "miniature"], "rationale": "Requis par ImageField — Django ne le tire PAS automatiquement" },
    { "module": "django-storages", "ref": "django-storages", "capability": "object-storage", "triggers": ["\\bs3\\b", "stockage.*objet", "azure.*blob"] },
    { "module": "celery", "ref": "celery", "capability": "background-jobs", "triggers": ["tache.*asynchrone", "background job", "worker", "celery"] },
    { "module": "redis", "ref": "redis", "capability": "background-jobs", "triggers": ["celery", "broker", "redis"] },
    { "module": "django-redis", "ref": "django-redis", "capability": "redis-cache", "triggers": ["cache", "redis"] },
    { "module": "django-allauth", "ref": "django-allauth", "capability": "auth-scaffold", "triggers": ["login", "inscription", "authentification", "oauth", "connexion.*google"], "rationale": "Vues et templates d'authentification prets a l'emploi — l'equivalent de laravel/breeze pour ce stack" },
    { "module": "django-anymail", "ref": "django-anymail", "capability": "transactional-email", "triggers": ["email.*transactionnel", "sendgrid", "mailgun"] },
    { "module": "django-health-check", "ref": "django-health-check", "capability": "healthcheck", "triggers": ["health", "readiness", "liveness"] },
    { "module": "sentry-sdk", "ref": "sentry-sdk", "capability": "sentry", "triggers": ["sentry", "error.*tracking", "monitoring.*erreurs"] },
    { "module": "django-debug-toolbar", "ref": "django-debug-toolbar", "capability": "dev-profiling", "triggers": ["debug.*toolbar", "profiler.*requetes", "n\\+1"], "rationale": "dev uniquement — s'injecte dans le HTML rendu, a ne JAMAIS activer en production" },
    { "module": "django-extensions", "ref": "django-extensions", "capability": "dev-profiling", "triggers": ["shell_plus", "graph_models"], "alternative": true },
    { "module": "openpyxl", "ref": "openpyxl", "capability": "excel", "triggers": ["excel", "xlsx", "export.*tableur"] },
    { "module": "reportlab", "ref": "reportlab", "capability": "pdf", "triggers": ["\\bpdf\\b", "export.*pdf", "generation.*document"] },
    { "module": "pytest-cov", "ref": "pytest-cov", "capability": "coverage", "triggers": ["coverage", "couverture.*tests"] },
    { "module": "model-bakery", "ref": "model-bakery", "capability": "test-fixtures", "triggers": ["fixture", "donnees.*test", "baker"] }
  ]
}
