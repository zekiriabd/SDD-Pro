{
  "$schema": "../../templates/libs-catalog.schema.json",
  "stackId": "kotlin-spring-boot",
  "category": "backend",
  "schemaVersion": 1,
  "buildSystem": "gradle",
  "manifest": {
    "files": [
      "workspace/output/src/{BackendName}/build.gradle.kts",
      "workspace/output/src/{BackendName}/gradle/libs.versions.toml",
      "workspace/output/src/{BackendName}/settings.gradle.kts"
    ],
    "versionCatalogPath": "gradle/libs.versions.toml"
  },
  "versions": {
    "kotlin": "2.3.21",
    "spring-boot": "4.0.6",
    "ktlint": "14.2.0",
    "spring-dotenv": "4.0.0",
    "flyway": "12.5.0",
    "springdoc": "2.7.0",
    "postgresql": "42.7.10",
    "mssql-jdbc": "12.8.1.jre11",
    "kotest": "5.9.1",
    "kotest-extensions-spring": "1.3.0",
    "nimbus-jose-jwt": "9.40",
    "mockwebserver": "4.12.0"
  },
  "dbDrivers": {
    "postgres":  { "module": "org.postgresql:postgresql", "ref": "postgresql" },
    "sqlserver": { "module": "com.microsoft.sqlserver:mssql-jdbc", "ref": "mssql-jdbc" }
  },
  "core": [
    { "module": "org.springframework.boot:spring-boot-starter-web" },
    { "module": "org.springframework.boot:spring-boot-starter-webflux" },
    { "module": "org.springframework.boot:spring-boot-starter-actuator" },
    { "module": "org.springframework.boot:spring-boot-starter-security" },
    { "module": "org.springframework.boot:spring-boot-starter-oauth2-resource-server" },
    { "module": "org.springframework.boot:spring-boot-starter-oauth2-client" },
    { "module": "org.springframework.boot:spring-boot-starter-data-jpa" },
    { "module": "org.springframework.boot:spring-boot-starter-flyway" },
    { "module": "org.flywaydb:flyway-core", "ref": "flyway" },
    { "module": "org.springdoc:springdoc-openapi-starter-webmvc-ui", "ref": "springdoc" },
    { "module": "me.paulschwarz:spring-dotenv", "ref": "spring-dotenv" },
    { "module": "org.springframework:spring-context" },
    { "module": "tools.jackson.module:jackson-module-kotlin" },
    { "module": "org.jetbrains.kotlin:kotlin-reflect", "ref": "kotlin" },
    { "module": "com.nimbusds:nimbus-jose-jwt", "ref": "nimbus-jose-jwt" },
    { "module": "org.springframework.boot:spring-boot-starter-test" },
    { "module": "org.springframework.boot:spring-boot-starter-webmvc-test" },
    { "module": "org.springframework.security:spring-security-test" },
    { "module": "io.kotest:kotest-runner-junit5", "ref": "kotest" },
    { "module": "io.kotest:kotest-assertions-core", "ref": "kotest" },
    { "module": "io.kotest.extensions:kotest-extensions-spring", "ref": "kotest-extensions-spring" },
    { "module": "com.squareup.okhttp3:mockwebserver", "ref": "mockwebserver" }
  ],
  "onDemand": [
    {
      "module": "org.springframework.boot:spring-boot-starter-data-redis",
      "capability": "redis-cache",
      "triggers": ["\\bredis\\b", "cache distribu", "distributed cache", "session partag"]
    },
    {
      "module": "org.flywaydb:flyway-sqlserver",
      "ref": "flyway",
      "capability": "sqlserver-flyway",
      "rationale": "Flyway 10+ a externalise le support SQL Server hors flyway-core. Obligatoire si DatabaseType=SqlServer ET Flyway active (sinon FlywayException: Unsupported Database). Cf. kotlin-spring-boot.md §4.4.1.",
      "triggers": ["sqlserver", "mssql"]
    }
  ],
  "plugins": [
    { "id": "org.jetbrains.kotlin.jvm", "ref": "kotlin" },
    { "id": "org.jetbrains.kotlin.plugin.spring", "ref": "kotlin" },
    { "id": "org.jetbrains.kotlin.plugin.jpa", "ref": "kotlin" },
    { "id": "org.springframework.boot", "ref": "spring-boot" },
    { "id": "org.jlleitschuh.gradle.ktlint", "ref": "ktlint" },
    { "id": "org.flywaydb.flyway", "ref": "flyway" }
  ],
  "metadata": {
    "lastUpdated": "2026-05-07",
    "format": "compact (v2)",
    "source": "User Working Agreement 2026-05-07 — schema v2 compact migration"
  }
}
